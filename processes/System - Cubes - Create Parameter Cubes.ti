#region Prolog
#### add rux using CubeRuleAppend

############# VARIABLES FOR PROCESS INFORMATION
sStartTime = TIMST( Now() , '\Y-\m-\d \h:\i:\s');
sStartValue = Now();
nRecords = 0;
sStatus = '';
nError = 0;
##############################################

####### SET PROCESESS DESCRIPTION #####
sDescription = 'Creates the parameters cubes required. Typically run at the start of development';
sDeveloper = 'Sempre: Shane James';
sSource = 'None';
sSourceType = 'None';
sTarget = 'System - List Table';
sTargetType = 'Cube';
sCube = 'System - Documentation - Model';
If(DIMIX('Documentation' , 'Process: '|GetProcessname() ) = 0);
    ExecuteProcess('System - Documentation - Update or Create Documentation Dimensions', 'pIncludeControlObjects', 'N', 'pDocumentElements', 'N' );
endif;
If(CubeExists( sCube ) > 0);
    CellPutS( sDescription, sCube, 'Process: '|GetProcessname(), 'Description' );
    CellPutS( sSource, sCube, 'Process: '|GetProcessname(), 'Process Source' );
    CellPutS( sTarget, sCube, 'Process: '|GetProcessname(), 'Process Target' );
    CellPutS( sSourceType, sCube, 'Process: '|GetProcessname(), 'Process Source Type' );
    CellPutS( sTargetType, sCube, 'Process: '|GetProcessname(), 'Process Target Type' );
    CellPutS( sDeveloper, sCube, 'Process: '|GetProcessname(), 'Developer' );
Endif;
#########################################

if (pConfirm @= 'N');
    sStatus = 'Process execution not confirmed';
    nError = 1;
    ProcessBreak; 
endif;

sDim1 = 'Parameters - User';
sDim2 = 'Parameters - System';
sDim3 = 'Parameters - Model';
sDim4 = 'Measures - Parameters';

sCubeUser = 'System - Parameters - User';
sCubeSystem = 'System - Parameters';
sCubeModel = 'System - Parameters - Model';

If(pConfirm @= 'Y');
    If(DimensionExists( sDim1 ) = 0, DimensionCreate( sDim1 ), 0);
    If(DimensionExists( sDim2 ) = 0, DimensionCreate( sDim2 ), 0);
    If(DimensionExists( sDim3 ) = 0, DimensionCreate( sDim3 ), 0);
    If(DimensionExists( sDim4 ) = 0, DimensionCreate( sDim4 ), 0);
    DimensionDeleteAllElements( sDim1 );
    DimensionDeleteAllElements( sDim2 );
    DimensionDeleteAllElements( sDim3 );
    DimensionDeleteAllElements( sDim4 );

    ##### Insert User Parameters #############################
    DimensionElementInsertDirect( sDim1, '', 'Last Login', 'N' );
    DimensionElementInsertDirect( sDim1, '', 'Email', 'N' );
    ##########################################################

    ##### Insert System Parameters #############################
    DimensionElementInsertDirect( sDim2, '', 'Model Name', 'N' );
    DimensionElementInsertDirect( sDim2, '', 'Environment Type', 'N' );
    DimensionElementInsertDirect( sDim2, '', 'Source Files Path', 'N' );
    DimensionElementInsertDirect( sDim2, '', 'Transfer Files Path', 'N' );
    sSub = 'Sys Leaf';
    sSubObj = 'Sys Objects Leaf';
    ### }Clients subsets
    sMDX  = '{TM1SORT( {TM1FILTERBYLEVEL( {TM1SUBSETALL( [}Clients] )}, 0)}, ASC)}';
    If(SubsetExists( '}Clients', sSub ) = 0, SubsetCreateByMDX( sSub, sMDX ),SubsetMDXSet('}Clients', sSub, sMDX));
    ### }Cubes subsets
    sMDX  = '{TM1SORT( {TM1FILTERBYLEVEL( {TM1SUBSETALL( [}Cubes] )}, 0)}, ASC)}';
    If(SubsetExists( '}Cubes', sSub )=0, SubsetCreateByMDX( sSub, sMDX ), SubsetMDXSet('}Cubes', sSub, sMDX));
    sMDX  = '{TM1FILTERBYPATTERN(TM1SubsetAll([}Cubes].[}Cubes]),"*}*","MEMBER_NAME")}';
    If(SubsetExists( '}Cubes', sSubObj )=0, SubsetCreateByMDX( sSubObj, sMDX ), SubsetMDXSet('}Cubes', sSubObj, sMDX));
    ### }Dimensions subsets
    sMDX  = '{TM1SORT( {TM1FILTERBYLEVEL( {TM1SUBSETALL( [}Dimensions] )}, 0)}, ASC)}';
    If(SubsetExists( '}Dimensions', sSub )=0, SubsetCreateByMDX( sSub, sMDX ),SubsetMDXSet('}Dimensions', sSub, sMDX));
    sMDX  = '{TM1FILTERBYPATTERN(TM1SubsetAll([}Dimensions].[}Dimensions]),"*}*","MEMBER_NAME")}';
    If(SubsetExists( '}Dimensions', sSubObj )=0, SubsetCreateByMDX( sSubObj, sMDX ), SubsetMDXSet('}Dimensions', sSubObj, sMDX));
    ### }Processes subsets
    sMDX  = '{TM1SORT( {TM1FILTERBYLEVEL( {TM1SUBSETALL( [}Processes] )}, 0)}, ASC)}';
    If(SubsetExists( '}Processes', sSub )=0, SubsetCreateByMDX( sSub, sMDX ),SubsetMDXSet('}Processes', sSub, sMDX));
    sMDX  = '{TM1FILTERBYPATTERN(TM1SubsetAll([}Processes].[}Processes]),"*}*","MEMBER_NAME")}';
    If(SubsetExists( '}Processes', sSubObj )=0, SubsetCreateByMDX( sSubObj, sMDX ), SubsetMDXSet('}Processes', sSubObj, sMDX));

    # DimensionElementInsertDirect( sDim2, '', 'Number of Model Cubes', 'N' );
    # DimensionElementInsertDirect( sDim2, '', 'Number of Model Dimensions', 'N' );
    # DimensionElementInsertDirect( sDim2, '', 'Number of Model Processes', 'N' );
    # DimensionElementInsertDirect( sDim2, '', 'Number of System Cubes', 'N' );
    # DimensionElementInsertDirect( sDim2, '', 'Number of System Dimensions', 'N' );
    # DimensionElementInsertDirect( sDim2, '', 'Number of System Processes', 'N' );
    # DimensionElementInsertDirect( sDim2, '', 'TOTAL CUBES', 'N' );
    # DimensionElementInsertDirect( sDim2, '', 'TOTAL DIMENSIONS', 'N' );
    # DimensionElementInsertDirect( sDim2, '', 'TOTAL PROCESSES', 'N' );
    # DimensionElementInsertDirect( sDim2, '', 'Number of Chores', 'N' );
    # DimensionElementComponentAddDirect( sDim2, 'TOTAL CUBES', 'Number of Model Cubes', 1 );
    # DimensionElementComponentAddDirect( sDim2, 'TOTAL CUBES', 'Number of System Cubes', 1 );
    # DimensionElementComponentAddDirect( sDim2, 'TOTAL DIMENSIONS', 'Number of Model Dimensions', 1 );
    # DimensionElementComponentAddDirect( sDim2, 'TOTAL DIMENSIONS', 'Number of System Dimensions', 1 );
    # DimensionElementComponentAddDirect( sDim2, 'TOTAL PROCESSES', 'Number of Model Processes', 1 );
    # DimensionElementComponentAddDirect( sDim2, 'TOTAL PROCESSES', 'Number of System Processes', 1 );
    ##########################################################


    ##### Insert Model Parameters #############################
    DimensionElementInsertDirect( sDim3, '', 'Current Year', 'N' );
    DimensionElementInsertDirect( sDim3, '', 'Prior Year', 'N' );
    DimensionElementInsertDirect( sDim3, '', 'Next Year', 'N' );
    DimensionElementInsertDirect( sDim3, '', 'Budget Year', 'N' );
    DimensionElementInsertDirect( sDim3, '', 'Closed Month', 'N' );
    DimensionElementInsertDirect( sDim3, '', 'Prior Month', 'N' );
    DimensionElementInsertDirect( sDim3, '', 'PY Closed Month', 'N' );
    DimensionElementInsertDirect( sDim3, '', 'Forecast Month', 'N' );
    DimensionElementInsertDirect( sDim3, '', 'Last Version Snapshot', 'N' );
    AttrInsert( sDim3, '', 'Picklist', 'S' );
    AttrPutS( 'subset:Year:Sys Leaf', sDim3, 'Current Year', 'PickList');
    AttrPutS( 'subset:Year:Sys Leaf', sDim3, 'Budget Year', 'PickList');
    AttrPutS( 'subset:Date Period:Curr and Bud Year Leaf', sDim3, 'Current Closed Month', 'PickList');
    AttrPutS( 'subset:Date Period:Curr and Bud Year Leaf', sDim3, 'Forecast Start Month', 'PickList');
    ##########################################################


    ##### Insert Measures - Parameters #############################
    DimensionElementInsertDirect( sDim4, '', 'String', 'S' );
    DimensionElementInsertDirect( sDim4, '', 'Value', 'N' );
    ##########################################################

Endif;
#endregion
#region Epilog



If(pConfirm @= 'Y');
    If(CubeExists( sCubeModel ) = 0, CubeCreate( sCubeModel, 'Parameters - Model', 'Measures - Parameters' ), 0);
    If(CubeExists( sCubeSystem ) = 0, CubeCreate( sCubeSystem, 'Parameters - System', 'Measures - Parameters' ), 0);
    If(CubeExists( sCubeUser ) = 0, CubeCreate( sCubeUser, '}Clients', 'Parameters - User', 'Measures - Parameters' ), 0);
endif;

if (nError = 0); 
    sStatus = 'Success'; 
endif;

###### PUBLISH PROCESS INFORMATION ######
sEndTime = TIMST( Now() , '\Y-\m-\d \h:\i:\s');
sEndValue = Now();
sProcess = GetProcessName();
sUser = ATTRS( '}Clients', TM1User(), '}TM1_DefaultDisplayValue' );
sErrorFile = GetProcessErrorFilename();
sCompletionTime = TIMST(sEndValue - sStartValue, '\i m \s s');
sParameters = 'pConfirm='|pConfirm|', pEmail='|pEmail;
##### Insert Time Record #############################
# sDim = 'Time Processes';
# DimensionElementInsertDirect(sDim, '', sEndTime, 'N' );
# ##########################################################
# sCube = 'System - Process Information';
# CellPutS( sStartTime, sCube, sEndTime, sProcess, 'Start Time' );
# CellPutS( sEndTime, sCube, sEndTime, sProcess, 'End Time' );
# CellPutS( sUser, sCube, sEndTime, sProcess, 'Executed By' );
# CellPutS( sParameters, sCube, sEndTime, sProcess, 'Parameters Used' );
# CellPutS( sStatus, sCube, sEndTime, sProcess, 'Execution Status' );
# CellPutS( 'Process', sCube, sEndTime, sProcess, 'Updated From' );
# CellPutS( sCompletionTime, sCube, sEndTime, sProcess, 'Completion Time' );
# CellPutS( sErrorFile, sCube, sEndTime, sProcess, 'Server Log Error' );
# sCube = 'System - Documentation - Model';
# CellPutS( sCompletionTime, sCube, 'Process: '|sProcess, 'Process Last Run Time' );
# CellPutS( sEndTime, sCube, 'Process: '|sProcess, 'Process Last Run' );
########################################



###### SEND EMAIL TO ADMIN OR USER ######
sEmailProcess = CellGets('System - Parameters', 'Email TI Process', 'String' );
sTM1User = TM1User();
iCalledByChore = if (SUBST(sTM1User, 1, 2) @= 'R*', 1, 0);
if (pEmail @= 'Y');
    iSendEmail = 0;

    if (iCalledByChore = 0);
        iSendEmail = 1;
    elseif (nError > 0);
        iSendEmail = 1;
    endif;

    if (iSendEmail = 1);
        # if non-native security is being used, try and use the nicely formatted name in preference to the long unique code.
        if (DimensionExists('}ElementAttributes_}Clients') = 1);
            if (dimix('}ElementAttributes_}Clients', '}TM1_DefaultDisplayValue') > 0 & dimix('}Clients', TM1User) > 0);
                sUserNiceName = trim(ATTRS('}Clients', sTM1User, '}TM1_DefaultDisplayValue'));
                if (sUserNiceName @<> ''); 	sTM1User = sUserNiceName;		endif;
            endif;
        endif;

        # The result of this process is sent to the calling user when run by hand or to admin when run by a chore.
        if (iCalledByChore = 1); 
            sAdmin1Email = CellGetS( 'System - Parameters', 'Administrator 1 Email', 'String' );
            sAdmin2Email = CellGetS( 'System - Parameters', 'Administrator 2 Email', 'String' );
            sAdmin3Email = CellGetS( 'System - Parameters', 'Administrator 3 Email', 'String' );
        Else;
            IF(CellGetS( 'System - Parameters - User', sTM1User, 'Email Is Valid', 'String') @= 'Yes');
                sRecipient = CellGetS( 'System - Parameters - User', sTM1User, 'Email', 'String' );
            else;
                sAdmin1Email = CellGetS( 'System - Parameters', 'Administrator 1 Email', 'String' );
                sAdmin2Email = CellGetS( 'System - Parameters', 'Administrator 2 Email', 'String' );
                sAdmin3Email = CellGetS( 'System - Parameters', 'Administrator 3 Email', 'String' );  
            endif;
        endif;

        sCC = 'X';
        sBCC = 'X';

        if (nError = 0); 
            sSubject = 'Process Success - '|sProcess; 
            sMessageStatus = '<font color="green">successfully</font>';
        Else;
            sSubject = 'Process Error - '|sProcess;
            sMessageStatus = '<font color="red">with errors</font> ';
        Endif; 

        if 	(lower(sTM1User) @= 'admin');	sUsernameToDisplay = 'Admin';
        elseif 	(iCalledByChore = 1);		sUsernameToDisplay = 'a Chore [' | subst(sTM1User, 3, long(sTM1User) - 2) | ']';
        else;
            sUsernameToDisplay = trim(CellGetS('System - Parameters - User', Tm1User(), 'Full Name', 'String' ));
            if ( sUsernameToDisplay @= '' ); sUsernameToDisplay = sTM1User;  endif;
        endif;

        sEmailMessage = '<p>Dear '|sUsernameToDisplay|'</p><p>PROCESS: '|sProcess|' has completed '|sMessageStatus|'</p><p>The following parameters were used - '|sParameters|'</p>';
        sEmailMessage = sEmailMessage | '<b>' | GetProcessName() | '</b> was run at ' | TIMST(NOW(), '\h:\i:\s') | ' by ' | sUsernameToDisplay | '.<br>';
        sEmailMessage = sEmailMessage | '<p>   </p>';

        sLogFilenameWithoutExtension = GetProcessName | ' EmailerLog';
        sAttachment = 'X';

        # Now call the process that sends the email.
        if (iCalledByChore = 1);
            if (sAdmin1Email @<> ''); 
                vResult = ExecuteProcess(sEmailProcess, 'pRecipient', sAdmin1Email, 'pCC', sCC, 'pBCC', sBCC, 'pSubject', sSubject, 
                                         'pBody', sEmailMessage, 'pLogFilenameWithoutExtension', sLogFilenameWithoutExtension, 'pAttachment', sAttachment);
            endif;
            if (sAdmin2Email @<> ''); 
                vResult = ExecuteProcess(sEmailProcess, 'pRecipient', sAdmin2Email, 'pCC', sCC, 'pBCC', sBCC, 'pSubject', sSubject, 
                                         'pBody', sEmailMessage, 'pLogFilenameWithoutExtension', sLogFilenameWithoutExtension, 'pAttachment', sAttachment); 
            endif;
            if (sAdmin3Email @<> ''); 
                vResult = ExecuteProcess(sEmailProcess, 'pRecipient', sAdmin3Email, 'pCC', sCC, 'pBCC', sBCC, 'pSubject', sSubject, 
                                         'pBody', sEmailMessage, 'pLogFilenameWithoutExtension', sLogFilenameWithoutExtension, 'pAttachment', sAttachment); 
            endif;
        Else;
            vResult = ExecuteProcess(sEmailProcess, 'pRecipient', sRecipient, 'pCC', sCC, 'pBCC', sBCC, 'pSubject', sSubject, 
                                     'pBody', sEmailMessage, 'pLogFilenameWithoutExtension', sLogFilenameWithoutExtension, 'pAttachment', sAttachment);
        endif;
    endif;
endif;


if (nError > 0); 
    ItemReject(sStatus); 
endif;


#endregion