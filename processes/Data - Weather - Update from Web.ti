#region Prolog

############# VARIABLES FOR PROCESS INFORMATION
sStartTime =Now() ;
nRecords = 0;
sStatus = '';
nError = 0;
sProcess = GetProcessName;
sErrorFile = GetProcessErrorFilename();
If(SUBST( TM1User(), 1, 2 ) @= 'R*' % DIMIX( '}Clients', TM1User() ) = 0);
    sUser = TM1User();
else;
    sUser = ATTRS( '}Clients', TM1User(), '}TM1_DefaultDisplayValue' );
endif;
sParameters = 'pConfirm='|pConfirm;   
#######################################

####### SET PROCESSES DOCUMENTATION #####
#### Edit variables below
if (1=1); 
    sDescription = 'The process is a default process to be used as the base for all other processes developed'; 
    sDeveloper = 'Sempre: Shane James';    
    sSource = 'Source'; 
    sSourceType = 'Source Type'; 
    sTarget = 'Target'; 
    sTargetType = 'Target Type'; 

    sCube = 'System - Documentation - Model';
    If(DIMIX('Documentation' , 'Process: '|GetProcessname() ) = 0);
        ExecuteProcess('System - Documentation - Update or Create Documentation Dimensions', 'pIncludeControlObjects', 'N', 'pDocumentElements', 'N' );
    endif;
    If(CubeExists( sCube ) > 0);
        CellPutS( sDescription, sCube, 'Process: '|GetProcessname(), 'Description' );
        CellPutS( sSource, sCube, 'Process: '|GetProcessname(), 'Process Source' );
        CellPutS( sTarget, sCube, 'Process: '|GetProcessname(), 'Process Target' );
        CellPutS( sSourceType, sCube, 'Process: '|GetProcessname(), 'Process Source Type' );
        CellPutS( sTargetType, sCube, 'Process: '|GetProcessname(), 'Process Target Type' );
        CellPutS( sDeveloper, sCube, 'Process: '|GetProcessname(), 'Developer' );
    Endif;
endif;

#########################################

if (pConfirm @= 'N');
    sStatus = 'Process execution not confirmed';
    nError=1;
    ProcessBreak; 
endif;

#### Update process information at start of process
sMessage = 'Process started';
sEndTime = 0;

RunProcess( 'System - Logging - Populate Process Info',
           'pConfirm', 'Y',
           'pProcess', sProcess,
           'pRecordsProcessed', nRecords,
           'pStartTime', sStartTime,
           'pEndTime', sEndTime,
           'pExecutedBy', sUser,
           'pParametersUsed', sParameters,
           'pExecutionStatus', sStatus,
           'pUpdatedFrom', 'Process',
           'pProcessMessage', sMessage,
           'pServerLogFile', sErrorFile );


sDim1 = 'Date';
sToday = TIMST( Now() , '\Y-\m-\d');
#ItemReject( sToday );

sCube = 'Weather';
sSub = '}TI_Process'|NumberToString(ROUND(RAND() * 1000)) ;
sView = '}TI_Process'|NumberToString(ROUND(RAND() * 1000)) ;

If(SubsetExists(sDim1, sSub) = 0);
    SubsetCreate(sDim1,sSub,0  );
Endif;
SubsetDeleteAllElements(sDim1, sSub);


### Load data into new subset
if(pDate @= '');
    sMDX = '{[Date].[Date].['|sToday |'] : [Date].[Date].['|sToday |'].LAG(365)}';
    SubsetCreatebyMDX( sSub, sMDX, 1 );
elseif(pDate @= 'Today');
    SubsetElementInsert(sDim1, sSub, sToday, 1);
else;
    SubsetElementInsert(sDim1, sSub, pDate, 1);
endif;


### Create View
If(Viewexists(sCube, sView) = 0, ViewCreate(sCube, sView), 0);
ViewSubsetAssign(sCube, sView, sDim1, sSub);
ViewZeroOut( sCube, sView );

DataSourceNameForServer = sDim1;
DataSourceType = 'Subset';
DatasourceDimensionSubset = sSub;


#endregion
#region Data

nLocationSize = SubsetGetSize( 'Locations', 'LEAF' );
While(nLocationSize > 0);
    sLocation = SubsetGetElementName( 'Locations', 'LEAF', nLocationSize );
    sLocation = ATTRS('Locations', sLocation, 'Post Code');
    sDate = vPeriod;
    sURL = 'http://api.weatherapi.com/v1/history.json?key=1a765b6e3420470c84d101204253107&q='|sLocation|'&dt='|sDate;

    ExecuteHttpRequest( 'GET', sURL, '-k' );
    sJsonResponse = HttpResponseGetBody();
    sStatus = NumberToString( HttpResponseGetStatusCode() );

    # first item in array
    sDayJson = JsonGet(sJsonResponse, '/forecast/forecastday/0', 1, '');

    nWeatherMeasureSize = SubsetGetSize( 'Measures - Weather', 'LEAF Measurements' );
    While(nWeatherMeasureSize > 0);
        sWeatherMeasure = SubsetGetElementName( 'Measures - Weather', 'LEAF Measurements', nWeatherMeasureSize );
        sJsonWeatherMeasure = ATTRS('Measures - Weather', sWeatherMeasure, 'Json Name');
        nMeasureValue = JsonGet(sDayJson, '/day/'|sJsonWeatherMeasure,1,'' );
        CellPutN(StringToNumber(  nMeasureValue),  sCube, sDate, slocation, sWeatherMeasure );
        nRecords = nRecords +1;
        nWeatherMeasureSize = nWeatherMeasureSize -1;
    end;
    nWeatherMeasureSize = SubsetGetSize( 'Measures - Weather', 'LEAF text' );
    While(nWeatherMeasureSize > 0);
        sWeatherMeasure = SubsetGetElementName( 'Measures - Weather', 'LEAF text', nWeatherMeasureSize );
        sJsonWeatherMeasure = ATTRS('Measures - Weather', sWeatherMeasure, 'Json Name');
        sMeasureValue = JsonGet(sDayJson, '/day/condition/'|sJsonWeatherMeasure,1,'' );
        CellPutS(sMeasureValue,  sCube, sDate, slocation, sWeatherMeasure );
        nWeatherMeasureSize = nWeatherMeasureSize -1;
        nRecords = nRecords +1;
    end;
    nLocationSize = nLocationSize -1;
end;



#endregion
#region Epilog

if (nError=0); 
    sStatus = 'Success'; 
endif;

###### PUBLISH PROCESS INFORMATION ######
sEndTime = Now();
sMessage = '';

RunProcess( 'System - Logging - Populate Process Info',
           'pConfirm', 'Y',
           'pProcess', sProcess,
           'pRecordsProcessed', nRecords,
           'pStartTime', sStartTime,
           'pEndTime', sEndTime,
           'pExecutedBy', sUser,
           'pParametersUsed', sParameters,
           'pExecutionStatus', sStatus,
           'pUpdatedFrom', 'Process',
           'pProcessMessage', sMessage,
           'pServerLogFile', sErrorFile );

####################################



if (nError > 0); 
    ItemReject(sStatus); 
endif;
#endregion