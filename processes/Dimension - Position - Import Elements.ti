#region Prolog

sDimName='Position';
#DimensionDeleteAllElements( sDimName );


#Unwind the dimension we are updating
iElm = 1;
ElmCount = DIMSIZ(sDimName);
WHILE(iElm < ElmCount); 
    sElm = DIMNM(sDimName,iElm);
    ChildCount = ELCOMPN(sDimName,sElm);
    WHILE(ChildCount > 0);
        sChildElm = ELCOMP(sDimName,sElm,ChildCount);
        DIMENSIONELEMENTCOMPONENTDELETE(sDimName, sElm, sChildElm );
        ChildCount = ChildCount - 1;
    END;
    iElm = iElm + 1;
END;

sTotal='All Positions';
DimensionElementInsertDirect( sDimName, '', sTotal, 'C' );


#endregion
#region Metadata

#Insert Elements and Attach to Total

if(DIMIX( sDimName, vPosID )=0);
    DimensionElementInsertDirect( sDimName, '', vPosID, 'N' );
endif;
    

DimensionElementComponentAddDirect( sDimName, sTotal, vPosID, 1 );



#endregion
#region Data

#Handle Blank Names



IF(TRIM(vPositionStatus) @<>'');
    AttrPutS( vPositionStatus, sDimName, vPosID, 'Position Status');
endif;

IF(TRIM(vCurrentWorkerTitle) @<>'');
    AttrPutS( vPosID|' - '|vCurrentWorkerTitle, sDimName, vPosID, 'Caption');
endif;

IF(TRIM(vCurrentWorkerTitle) @<>'');
    AttrPutS( vCurrentWorkerTitle,sDimName, vPosID, 'Current Worker Title');
endif;

IF(TRIM(vCompany) @<>'');
    AttrPutS( vCompany, sDimName, vPosID, 'Company');
endif;

IF(TRIM(vTeam) @<>'');
    AttrPutS( vTeam, sDimName, vPosID, 'Team');
endif;

IF(TRIM(vManager) @<>'');
    AttrPutS( vManager, sDimName, vPosID, 'Manager');
endif;

IF(TRIM(vWorkerType) @<>'');
    AttrPutS( vWorkerType, sDimName, vPosID, 'Worker Type');
endif;

IF(TRIM(vCostCentre) @<>'');
    AttrPutS( vCostCentre, sDimName, vPosID, 'Cost Centre');
endif;

IF(TRIM(vLocation) @<>'');
    sLocation = ATTRS('Location Lookup', vLocation, 'Map To' );
    AttrPutS( sLocation, sDimName, vPosID, 'Location');
endif;

IF(TRIM(vPositionWorkerType) @<>'');
    AttrPutS( vPositionWorkerType, sDimName, vPosID, 'Position Worker Type');
endif;



#endregion