### Consolidations ###
sWeeks = 'TOTAL WEEKS';
sPeriods = 'TOTAL PERIODS';
sYears = 'TOTAL YEARS';
sQuarters = 'TOTAL QTRS';
sHalves = 'TOTAL HALF YEARS';

HierarchyElementInsert( sDim2, sDim2, sInsertionPoint, sPeriods, sTypeC );
HierarchyElementInsert( sDim3, sDim3, sInsertionPoint, sYears, sTypeC );
HierarchyElementInsert( sDim4, sDim4, sInsertionPoint, sYears, sTypeC );
HierarchyElementInsert( sDim1, sDim1, sInsertionPoint, sYears, sType );
HierarchyElementInsert( sDim1, sDim1, sInsertionPoint, sQuarters, sType );
HierarchyElementInsert( sDim1, sDim1, sInsertionPoint, sHalves, sType );
HierarchyElementInsert( sDim5, sDim5, sInsertionPoint, sYears, sType );
HierarchyElementInsert( sDim1, sDim1, sInsertionPoint, 'No Date', sType );

HierarchyElementInsert( sDim4, sDim4,sInsertionPoint, 'No Date', sType );

