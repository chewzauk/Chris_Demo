sDim1 = 'PeriodYear';
sDim2 = 'Period';
sDim3 = 'Year';
sDim4 = 'Date';
sDim5 = 'WeekYear';


sCompSortType = 'ByInput';
sCompSortOrder = 'Ascending';
sElSortType = 'ByHierarchy';
sElSortOrder = 'Ascending';
sInsertionPoint = '';
sType = 'N';
sTypeC = 'C';
nWeight = 1;

nDateIndex = 0;
nDateWeekIndex = 0;
nDatePeriodIndex = 0;
sPriorWeek = '0';
sPriorPeriod = '0';

sTypeS = 'S';
sTypeN = 'N';
sTypeA ='A';

##### Create Dimensions #####
n=1;
While (n <= 5);
    If(DimensionExists(Expand('%sDim'|NumbertoString(n)|'%')) > 0);
        ExecuteProcess( '}bedrock.hier.unwind', 'pLogOutput', 0,
                       'pDim', Expand('%sDim'|NumbertoString(n)|'%') , 'pHier', Expand('%sDim'|NumbertoString(n)|'%'), 'pConsol', '*',
                       'pRecursive', 1, 'pDelim', '&'
                      );

    Endif;
    If(DimensionExists(Expand('%sDim'|NumbertoString(n)|'%')) = 0);
        DimensionCreate( Expand('%sDim'|NumbertoString(n)|'%'));
    Endif;
    DimensionSortOrder( Expand('%sDim'|NumbertoString(n)|'%'), sCompSortType, sCompSortOrder, sElSortType, sElSortOrder );
    n=n+1;
End;

