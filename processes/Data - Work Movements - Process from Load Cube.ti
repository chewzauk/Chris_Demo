#region Prolog

sSrcCube = 'Employee - Mapping';


#endregion
#region Metadata



#endregion
#region Data

sCurrentPosition = CellGetS('Worker Movements', vList, 'Current Position' );
sCurrentCompany = CellGetS('Worker Movements', vList, 'Current Company' );
sCurrentRespCentre = CellGetS('Worker Movements', vList, 'Current Responsibility Centre' );
sCurrentGrade = CellGetS('Worker Movements', vList, 'Current Grade' );
sCurrentSalary = CellGetN('Worker Movements', vList, 'Current Salary' );
sCurrency = 'LC';

sNewPosition = CellGetS('Worker Movements', vList, 'New Position' );
sNewCompany = CellGetS('Worker Movements', vList, 'New Company' );
sNewRespCentre = CellGetS('Worker Movements', vList, 'New Responsibility Centre' );
sNewGrade = CellGetS('Worker Movements', vList, 'New Grade' );
sNewSalary = CellGetN('Worker Movements', vList, 'New Salary' );

sPosition = IF(sNewPosition @= '', sCurrentPosition, sNewPosition);
sCompany = IF(sNewCompany @= '', sCurrentCompany, sNewCompany);
sRespCentre = IF(sNewRespCentre @= '', sCurrentRespCentre, sNewRespCentre);
sGrade = IF(sNewGrade @= '', sCurrentGrade, sNewGrade);
nSalary = IF(sNewSalary = 0, sCurrentSalary, sNewSalary);



sStartMonth = ATTRS('Date', CellGetS('Worker Movements', vList, 'Movement Date' ), 'yyyymm' );
sYear = ATTRS('PeriodYear', sStartMonth, 'Financial Year');

nFlex = CellGetN( 'Payroll Plan - Annual', sYear, pVersion, vValue, 'Flex Allowance' );
nPension = CellGetN( 'Payroll Plan - Annual', sYear, pVersion, vValue, 'Pension %' );
nFTE = CellGetN('Payroll', sStartMonth, pVersion, sCurrentCompany, sCurrentRespCentre, vValue, sCurrentPosition, 'LC', 'FTE');


### Put new Employee Data
sLastPeriod = ATTRS('Periodyear', ATTRS('Version', pVersion, 'End Period'), 'Next');
sPeriod = sStartMonth;
sCubeName = 'Payroll';

sPeriod = ATTRS('PeriodYear', sPeriod, 'Next');
while (sPeriod @<> sLastPeriod); 
    CellPutN( nFTE, sCubeName, sPeriod, pVersion, sCompany, sRespCentre, vValue, sPosition, 'LC', 'FTE' );
    CellPutN(1, sCubeName, sPeriod, pVersion, sCompany, sRespCentre, vValue, sPosition, 'LC', 'Headcount' );

    CellPutN(0, sCubeName, sPeriod, pVersion, sCurrentCompany, sCurrentRespCentre, vValue, sCurrentPosition, 'LC', 'FTE' );
    CellPutN(0, sCubeName, sPeriod, pVersion, sCurrentCompany, sCurrentRespCentre, vValue, sCurrentPosition, 'LC', 'Headcount' );
    sPeriod = ATTRS('PeriodYear', sPeriod, 'Next');
end;

sProcessTime = TIMST( Now() , '\Y-\m-\d \h:\i:\s');

CellPutS( 'Processed into '| pVersion|' at '|sProcessTime, 'Worker Movements', vList, 'Status' );








#endregion
#region Epilog

###### SEND EMAIL TO ADMIN OR USER ######
sEmailProcess = CellGets('System - Parameters', 'Email TI Process', 'String' );
sTM1User = TM1User();
sProcess = GetProcessName();
sParameters = 'pVersion='|pVersion;  
sRecipient = CellGetS( 'System - Parameters - User', sTM1User, 'Email', 'String' );

# if non-native security is being used, try and use the nicely formatted name in preference to the long unique code.
if (DimensionExists('}ElementAttributes_}Clients') = 1);
    if (dimix('}ElementAttributes_}Clients', '}TM1_DefaultDisplayValue') > 0 & dimix('}Clients', TM1User) > 0);
        sUserNiceName = trim(ATTRS('}Clients', sTM1User, '}TM1_DefaultDisplayValue'));
        if (sUserNiceName @<> ''); 	sTM1User = sUserNiceName;		endif;
    endif;
endif;

sSubject = 'Process Success - '|sProcess; 
sMessageStatus =  '<font color=green>successfully</font>';


sUsernameToDisplay = trim(CellGetS('System - Parameters - User', Tm1User(), 'Full Name', 'String' ));
if ( sUsernameToDisplay @= '' ); sUsernameToDisplay = sTM1User;  endif;


sEmailMessage = '<p>Dear '|sUsernameToDisplay|'</p><p>PROCESS: '|sProcess|' has completed '|sMessageStatus|'</p><p>The following parameters were used - '|sParameters|'</p>';
sEmailMessage = sEmailMessage | '<b>' | GetProcessName() | '</b> was run at ' | TIMST(NOW(), '\h:\i:\s') | ' by ' | sUsernameToDisplay | '.<br>';

# sEmailMessage = 'Dear '|sUsernameToDisplay|char(10)|'
# PROCESS: '|sProcess|' has completed '|sMessageStatus|char(10)|'The following parameters were used - '|sParameters;
# sEmailMessage = sEmailMessage  |char(10)|GetProcessName() | ' was run at ' | TIMST(NOW(), '\h:\i:\s') | ' by ' | sUsernameToDisplay;

# Now call the process that sends the email.
LogOutput( 'INFO', sRecipient );
LogOutput( 'INFO', sSubject );
LogOutput( 'INFO', sEmailMessage );


ExecuteProcess(sEmailProcess, 'pConfirm', 'Y', 'pToEmail', sRecipient, 'pSubject', sSubject, 'pBody', sEmailMessage);

#endregion