#region Prolog

nRowCount= 0;

sPeriod=TRIM(SUBST( pPeriod, 1,3));
sErrExportPath='Source Files/Exports/TI Exports';
sEmpMapCube='Employee - Mapping';

DataSourceType = 'CHARACTERDELIMITED';
DatasourceNameForServer =  'Source Files/Cube Loads/Payroll Data Actuals/ASOS.COM/'|sPeriod|' FY25 .com Payroll POC.csv';
DatasourceASCIIDelimiter = ',';
DatasourceASCIIHeaderRecords = 8;


sCubeName='Payroll';
sSrcDim1='PeriodYear';
sSrcDim2='Version';
sSrcDim3='Company';
sSrcDim4='Responsibility Centre';
sSrcDim5='Employee';
sSrcDim6='Position';
sSrcDim7='Currency';
sSrcDim8='Measures - Payroll';


#Recreate Views and Subsets

sSrcView=GetProcessName();

if(ViewExists( sCubeName, sSrcView )=1);
    ViewDestroy( sCubeName, sSrcView );
endif;

if(SubsetExists( sSrcDim1, sSrcView )=1);
    SubsetDestroy( sSrcDim1, sSrcView );
endif;

if(SubsetExists( sSrcDim2, sSrcView )=1);
    SubsetDestroy( sSrcDim2, sSrcView );
endif;

if(SubsetExists( sSrcDim6, sSrcView )=1);
    SubsetDestroy( sSrcDim6, sSrcView );
endif;


ViewCreate( sCubeName, sSrcView, pTemp);

sMdx='{[PeriodYear].[PeriodYear].['|pPeriod|']}';
SubsetCreatebyMDX( sSrcView, sMdx, pTemp);
ViewSubsetAssign( sCubeName, sSrcView, sSrcDim1, sSrcView );

sMdx='{[Version].[Version].[Actual]}';
SubsetCreatebyMDX( sSrcView, sMdx, pTemp);
ViewSubsetAssign( sCubeName, sSrcView, sSrcDim2, sSrcView );

sMdx='{[Company].[Company].[ASOS.com Ltd]}';
SubsetCreatebyMDX( sSrcView, sMdx, pTemp);
ViewSubsetAssign( sCubeName, sSrcView, sSrcDim3, sSrcView );

sMdx='{[Currency].[Currency].[LC]}';
SubsetCreatebyMDX( sSrcView, sMdx, pTemp);
ViewSubsetAssign( sCubeName, sSrcView, sSrcDim7, sSrcView );



#ZeroOut Period

ViewZeroOut( sCubeName, sSrcView );


#endregion
#region Metadata

if(vEmpID @='' );
    ItemSkip;
endif;

#Add Employees to the Dim if they don't exist


if(DIMIX( sSrcDim5, vEmpID )=0);
    DimensionElementInsertDirect( sSrcDim5, '', vEmpID, 'N' );
    DimensionElementComponentAddDirect( sSrcDim5, 'All Employees', vEmpID, 1 );
endif;

#Position ID Check

if(vPosID@='');
    ItemSkip;
elseif(DIMIX( sSrcDim6, vPosID )=0);
    DimensionElementInsertDirect( sSrcDim6, '', vPosID, 'N' );
    DimensionElementComponentAddDirect( sSrcDim6, 'All Positions', vPosID, 1 );   
    #ASCIIOutput( sErrExportPath|'/PositionID.CSV',pPeriod,vPosID,vEmpID );
endif;


#endregion
#region Data


sRC=SUBST( vAccount, 8, 4 );
sAccount=SUBST( vAccount, 1, 6 );


if(vEmpID @='');
    ItemSkip;
endif;

if(vPosID @='');
    vPosID='No Position';
endif;

if(DIMIX( sSrcDim4, sRC )=-0);
    sRC='Unknown Responsibility Centre';
endif;


IF(DIMIX( 'Measures - Payroll', sAccount )=0);
    ItemSkip;
endif;

#If Attributes are Currently blank, update the them from the monthly file

#Employee

if(ATTRS( sSrcDim5, vEmpID, 'Employee Name' )@='');
    AttrPutS( vEmpName|' - '|vEmpID, sSrcDim5, vEmpID, 'Employee Name' );
endif;

if(ATTRS( sSrcDim5, vEmpID, 'Currency' )@='');
    AttrPutS( vCurrency, sSrcDim5, vEmpID, 'Currency' );
endif;

if(ATTRS( sSrcDim5, vEmpID, 'Country' )@='');
    AttrPutS( 'UK', sSrcDim5, vEmpID, 'Country' );
endif;

if(ATTRS( sSrcDim5, vEmpID, 'Company' )@='');
    AttrPutS( 'ASOS.Com Ltd', sSrcDim5, vEmpID, 'Company' );
endif;


if(ATTRS( sSrcDim5, vEmpID, 'Cost Centre' )@='');
    sCostCentre=ATTRS( sSrcDim4, sRC, 'Caption' );
    AttrPutS( sCostCentre, sSrcDim5, vEmpID, 'Cost Centre' );
endif;

#Position

if(ATTRS( sSrcDim6, vPosID, 'Caption' )@='');
    if (CellGetS( sEmpMapCube, pPeriod, vEmpID, 'Team' )@<>''); 
        AttrPutS( vPosID |' - n/k - '|CellGetS( sEmpMapCube, pPeriod, vEmpID, 'Team' ), sSrcDim6, vPosID, 'Caption' ); 
    else;
        AttrPutS( vPosID |' - Archived', sSrcDim6, vPosID, 'Caption' );
    endif;    
endif;


if(ATTRS( sSrcDim6, vPosID, 'Position Status' )@='');
    if (CellGetS( sEmpMapCube, pPeriod, vEmpID, 'Team' )@<>''); 
        AttrPutS( 'Filled', sSrcDim6, vPosID, 'Position Status' ); 
    else;
        AttrPutS( 'Archived', sSrcDim6, vPosID, 'Position Status' );
    endif;    
endif;


if(ATTRS( sSrcDim6, vPosID, 'Team' )@='');
    if (CellGetS( sEmpMapCube, pPeriod, vEmpID, 'Team' )@<>''); 
        AttrPutS( CellGetS( sEmpMapCube, pPeriod, vEmpID, 'Team' ), sSrcDim6, vPosID, 'Team' ); 
    else;
        AttrPutS( 'Unknown Team', sSrcDim6, vPosID, 'Team' );
    endif;    
endif;

if(ATTRS( sSrcDim6, vPosID, 'Manager' )@='');
    if (CellGetS( sEmpMapCube, pPeriod, vEmpID, 'Manager' )@<>''); 
        AttrPutS( CellGetS( sEmpMapCube, pPeriod, vEmpID, 'Manager' ), sSrcDim6, vPosID, 'Manager' ); 
    else;
        AttrPutS( 'Unknown Manager', sSrcDim6, vPosID, 'Manager' );
    endif;    
endif;


if(ATTRS( sSrcDim6, vPosID, 'Cost Centre' )@='');
    if (CellGetS( sEmpMapCube, pPeriod, vEmpID, 'Cost Centre' )@<>''); 
        AttrPutS( CellGetS( sEmpMapCube, pPeriod, vEmpID, 'Cost Centre' ), sSrcDim6, vPosID, 'Cost Centre' ); 
    else;
        AttrPutS( 'Unknown Cost Centre', sSrcDim6, vPosID, 'Cost Centre' );
    endif;    
endif;

if(ATTRS( sSrcDim6, vPosID, 'Location' )@='');
    if (CellGetS( sEmpMapCube, pPeriod, vEmpID, 'Location' )@<>''); 
        AttrPutS( CellGetS( sEmpMapCube, pPeriod, vEmpID, 'Location' ), sSrcDim6, vPosID, 'Location' ); 
    else;
        AttrPutS( 'Unknown Location', sSrcDim6, vPosID, 'Location' );
    endif;    
endif;

if(ATTRS( sSrcDim6, vPosID, 'Worker Type' )@='');
    if (CellGetS( sEmpMapCube, pPeriod, vEmpID, 'Worker Type' )@<>''); 
        AttrPutS( CellGetS( sEmpMapCube, pPeriod, vEmpID, 'Worker Type' ), sSrcDim6, vPosID, 'Worker Type' ); 
    else;
        AttrPutS( 'Unknown Worker Type', sSrcDim6, vPosID, 'Worker Type' );
    endif;    
endif;


if(ATTRS( sSrcDim6, vPosID, 'Company' )@='');
    AttrPutS( 'ASOS.Com Ltd', sSrcDim6, vPosID, 'Company' );
endif;

if(ATTRS( sSrcDim6, vPosID, 'Position Worker Type' )@='');
    AttrPutS( 'Unknown Position Worker Type', sSrcDim6, vPosID, 'Position Worker Type' );
endif;

if(ATTRS( sSrcDim6, vPosID, 'Current Worker Title' )@='');
    AttrPutS( 'Unknown Current Worker Title', sSrcDim6, vPosID, 'Current Worker Title' );
endif;

if (sAccount @= '710030'); 
    sAccount = 'Statutory Maternity Pay';
endif;



if (sAccount @= '710005'); 
    sAccount = 'Salary';
    CellPutN( 1, sCubeName, pPeriod, 'Actual', 'ASOS.com Ltd', sRC, vEmpID, vPosID, 'LC', 'Headcount' ); 
    nFTE = IF(CellGetN( sEmpMapCube, pPeriod, vEmpID, 'FTE %' ) = 0, 1, CellGetN( sEmpMapCube, pPeriod, vEmpID, 'FTE %' ) /100);
    CellPutN( nFTE, sCubeName, pPeriod, 'Actual', 'ASOS.com Ltd', sRC, vEmpID, vPosID, 'LC', 'FTE' );  
endif;


# if(pClearMonth @<>'Y');
CellIncrementN( vNet, sCubeName, pPeriod, 'Actual', 'ASOS.com Ltd', sRC, vEmpID, vPosID, 'LC', sAccount );

# endif;
nRowCount = nRowCount + 1;


#endregion
#region Epilog


###### SEND EMAIL TO ADMIN OR USER ######
sEmailProcess = CellGets('System - Parameters', 'Email TI Process', 'String' );
sTM1User = TM1User();
sProcess = GetProcessName();
sParameters = 'pPeriod='|pPeriod;  
sRecipient = CellGetS( 'System - Parameters - User', sTM1User, 'Email', 'String' );

# if non-native security is being used, try and use the nicely formatted name in preference to the long unique code.
if (DimensionExists('}ElementAttributes_}Clients') = 1);
    if (dimix('}ElementAttributes_}Clients', '}TM1_DefaultDisplayValue') > 0 & dimix('}Clients', TM1User) > 0);
        sUserNiceName = trim(ATTRS('}Clients', sTM1User, '}TM1_DefaultDisplayValue'));
        if (sUserNiceName @<> ''); 	sTM1User = sUserNiceName;		endif;
    endif;
endif;

sSubject = 'Process Success - '|sProcess; 
sMessageStatus =  '<font color=green>successfully</font>';


sUsernameToDisplay = trim(CellGetS('System - Parameters - User', Tm1User(), 'Full Name', 'String' ));
if ( sUsernameToDisplay @= '' ); sUsernameToDisplay = sTM1User;  endif;


sEmailMessage = '<p>Dear '|sUsernameToDisplay|'</p><p>PROCESS: '|sProcess|' has completed '|sMessageStatus|'</p><p>The following parameters were used - '|sParameters|'</p>';
sEmailMessage = sEmailMessage | '<b>' | NumberToString( nRowCount ) | '</b> rows were loaded.<br>';
sEmailMessage = sEmailMessage | '<b>' | GetProcessName() | '</b> was run at ' | TIMST(NOW(), '\h:\i:\s') | ' by ' | sUsernameToDisplay | '.<br>';

# sEmailMessage = 'Dear '|sUsernameToDisplay|char(10)|'
# PROCESS: '|sProcess|' has completed '|sMessageStatus|char(10)|'The following parameters were used - '|sParameters;
# sEmailMessage = sEmailMessage  |char(10)|GetProcessName() | ' was run at ' | TIMST(NOW(), '\h:\i:\s') | ' by ' | sUsernameToDisplay;

# Now call the process that sends the email.
LogOutput( 'INFO', sRecipient );
LogOutput( 'INFO', sSubject );
LogOutput( 'INFO', sEmailMessage );


ExecuteProcess(sEmailProcess, 'pConfirm', 'Y', 'pToEmail', sRecipient, 'pSubject', sSubject, 'pBody', sEmailMessage);

#endregion