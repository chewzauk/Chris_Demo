#region Prolog

############# VARIABLES FOR PROCESS INFORMATION
sStartTime = TIMST( Now() , '\Y-\m-\d \h:\i:\s');
sStartValue = Now();
nRecords = 0;
sStatus = '';
nError = 0;
##############################################

####### SET PROCESSES DOCUMENTATION #####
#### Edit variables below
sDescription = 'The process is a default process to be used as the base for all other processes developed'; 
sDeveloper = 'Sempre: Shane James';    
sSource = 'Source'; 
sSourceType = 'Source Type'; 
sTarget = 'Company'; 
sTargetType = 'Dimension'; 

sCube = 'System - Documentation - Model';
If(DIMIX('Documentation' , 'Process: '|GetProcessname() ) = 0);
    ExecuteProcess('System - Documentation - Update or Create Documentation Dimensions', 'pIncludeControlObjects', 'N', 'pDocumentElements', 'N' );
endif;
If(CubeExists( sCube ) > 0);
    CellPutS( sDescription, sCube, 'Process: '|GetProcessname(), 'Description' );
    CellPutS( sSource, sCube, 'Process: '|GetProcessname(), 'Process Source' );
    CellPutS( sTarget, sCube, 'Process: '|GetProcessname(), 'Process Target' );
    CellPutS( sSourceType, sCube, 'Process: '|GetProcessname(), 'Process Source Type' );
    CellPutS( sTargetType, sCube, 'Process: '|GetProcessname(), 'Process Target Type' );
    CellPutS( sDeveloper, sCube, 'Process: '|GetProcessname(), 'Developer' );
Endif;
#########################################

if (pConfirm @= 'N');
    sStatus = 'Process execution not confirmed';
    nError=1;
    ProcessBreak; 
endif;

sDim = 'Company';

#Providence VII Strike Limited

sConsol = 'ALL COMPANIES';
sRegionConsol = 'ALL REGIONS';
sCountryConsol = 'ALL COUNTRIES';
sCurrencyConsol = 'ALL CURRENCIES';
sDivisionsConsol = 'ALL DIVISIONS';

if (1=0); 
    ExecuteProcess( '}bedrock.hier.unwind', 'pLogOutput', 1,
                   'pDim', sDim , 'pHier', sDim, 'pConsol', 'ALL COMPANIES',
                   'pRecursive', 1, 'pDelim', '&'
                  );
    ExecuteProcess( '}bedrock.hier.unwind', 'pLogOutput', 1,
                   'pDim', sDim , 'pHier', sDim, 'pConsol', sRegionConsol,
                   'pRecursive', 1, 'pDelim', '&'
                  );
    ExecuteProcess( '}bedrock.hier.unwind', 'pLogOutput', 1,
                   'pDim', sDim , 'pHier', sDim, 'pConsol', sCountryConsol,
                   'pRecursive', 1, 'pDelim', '&'
                  );
    ExecuteProcess( '}bedrock.hier.unwind', 'pLogOutput', 1,
                   'pDim', sDim , 'pHier', sDim, 'pConsol', sCurrencyConsol,
                   'pRecursive', 1, 'pDelim', '&'
                  );
    ExecuteProcess( '}bedrock.hier.unwind', 'pLogOutput', 1,
                   'pDim', sDim , 'pHier', sDim, 'pConsol', sDivisionsConsol,
                   'pRecursive', 1, 'pDelim', '&'
                  );
else;
    DimensionDeleteAllElements( sDim );
endif;



DimensionElementInsert( sDim, '', sConsol, 'C' );
DimensionElementInsert( sDim, '', sRegionConsol, 'C' );
DimensionElementInsert( sDim, '', sCountryConsol, 'C' );
DimensionElementInsert( sDim, '', sCurrencyConsol, 'C' );
DimensionElementInsert( sDim, '', sDivisionsConsol, 'C' );

AttrInsert( sDim, '', 'Division', 'S' );
AttrInsert( sDim, '', 'Currency', 'S' );
AttrInsert( sDim, '', 'Country', 'S' );
AttrInsert( sDim, '', 'Region', 'S' );
AttrInsert( sDim, '', 'Type', 'S' );
AttrInsert( sDim, '', 'CodeDescription', 'A' );
AttrInsert( sDim, '', 'Description', 'A' );

#endregion
#region Metadata

#### ALL LEGAL ENTITIES
DimensionElementInsert( sDim, '', Maconomy_Company_ID, 'N' );
DimensionElementInsert( sDim, '', Company_rollup_1, 'C' );
DimensionElementInsert( sDim, '', Company_rollup_2, 'C' );
DimensionElementInsert( sDim, '', Company_rollup_3, 'C' );
DimensionElementInsert( sDim, '', Company_rollup_4, 'C' );
DimensionElementInsert( sDim, '', Company_rollup_5, 'C' );
DimensionElementComponentAdd( sDim, sConsol, Maconomy_Company_ID, 1 );

### MAIN HIERARCHY BASED ON COMPANY ROLLUP FIELDS
if (Maconomy_Company_ID @<> Company_rollup_1); 
    DimensionElementComponentAdd( sDim, Company_rollup_1, Maconomy_Company_ID, 1 );
elseif (Maconomy_Company_ID @<> Company_rollup_2); 
    DimensionElementComponentAdd( sDim, Company_rollup_2, Maconomy_Company_ID, 1 );
Elseif(Maconomy_Company_ID @<> Company_rollup_3);
    DimensionElementComponentAdd( sDim, Company_rollup_3, Maconomy_Company_ID, 1 );
Elseif(Maconomy_Company_ID @<> Company_rollup_4);
    DimensionElementComponentAdd( sDim, Company_rollup_4, Maconomy_Company_ID, 1 );
Elseif(Maconomy_Company_ID @<> Company_rollup_5);
    DimensionElementComponentAdd( sDim, Company_rollup_5, Maconomy_Company_ID, 1 );
endif;

if (Company_rollup_1 @<> Company_rollup_2); 
    DimensionElementComponentAdd( sDim, Company_rollup_2, Company_rollup_1, 1 );
Elseif(Company_rollup_1 @<> Company_rollup_3);
    DimensionElementComponentAdd( sDim, Company_rollup_3, Company_rollup_1, 1 );
Elseif(Company_rollup_1 @<> Company_rollup_4);
    DimensionElementComponentAdd( sDim, Company_rollup_4, Company_rollup_1, 1 );
Elseif(Company_rollup_1 @<> Company_rollup_5);
    DimensionElementComponentAdd( sDim, Company_rollup_5, Company_rollup_1, 1 );
endif;

if(Company_rollup_2 @<> Company_rollup_3);
    DimensionElementComponentAdd( sDim, Company_rollup_3, Company_rollup_2, 1 );
Elseif(Company_rollup_2 @<> Company_rollup_4);
    DimensionElementComponentAdd( sDim, Company_rollup_4, Company_rollup_2, 1 );
Elseif(Company_rollup_2 @<> Company_rollup_5);
    DimensionElementComponentAdd( sDim, Company_rollup_5, Company_rollup_2, 1 );
endif;

if(Company_rollup_3 @<> Company_rollup_4);
    DimensionElementComponentAdd( sDim, Company_rollup_4, Company_rollup_3, 1 );
Elseif(Company_rollup_2 @<> Company_rollup_5);
    DimensionElementComponentAdd( sDim, Company_rollup_5, Company_rollup_3, 1 );
endif;

if(Company_rollup_4 @<> Company_rollup_5);
    DimensionElementComponentAdd( sDim, Company_rollup_5, Company_rollup_4, 1 );
endif;



### HIERARCHY BASED ON ATTRIBUTES
## REGION
if (Region @<> ''); 
    DimensionElementInsert( sDim, '', Region, 'N' );
    DimensionElementComponentAdd( sDim, Region, Maconomy_Company_ID, 1 );
    DimensionElementComponentAdd( sDim, sRegionConsol, Region, 1 ); 
endif;


## CURRENCY
if (Currency @<> ''); 
    DimensionElementInsert( sDim, '', Currency, 'N' );
    DimensionElementComponentAdd( sDim, Currency, Maconomy_Company_ID, 1 );
    DimensionElementComponentAdd( sDim, sCurrencyConsol, Currency, 1 );
endif;

## COUNTRY
if (Country @<> ''); 
    DimensionElementInsert( sDim, '', Country, 'N' );
    DimensionElementComponentAdd( sDim, Country, Maconomy_Company_ID, 1 );
    DimensionElementComponentAdd( sDim, sCountryConsol, Country, 1 );
endif;

## DIVISION
if (Division @<> ''); 
    sDivision = Division;
    DimensionElementInsert( sDim, '', sDivision, 'N' );
    DimensionElementComponentAdd( sDim, sDivision, Maconomy_Company_ID, 1 );
    DimensionElementComponentAdd( sDim, sDivisionsConsol, sDivision, 1 );
Endif;



#endregion
#region Data

AttrPutS( Currency, sDim, Maconomy_Company_ID, 'Currency');
AttrPutS( Country, sDim, Maconomy_Company_ID, 'Country');
AttrPutS( Region, sDim, Maconomy_Company_ID, 'Region');
AttrPutS( Division, sDim, Maconomy_Company_ID, 'Division');
AttrPutS( Type, sDim, Maconomy_Company_ID, 'Type');
AttrPutS( Maconomy_Company_ID|' - '|Company_Name, sDim, Maconomy_Company_ID, 'CodeDescription');


if(DIMIX( sDim, Company_Name ) = 0);
    AttrPutS( Company_Name, sDim, Maconomy_Company_ID, 'Description');
endif;

#endregion
#region Epilog

if (nError=0); 
    sStatus = 'Success'; 
endif;

ExecuteProcess( 'System - Dimension - Create Hierarchy from Attribute',
               'pConfirm', 'Y',
               'pEmail', 'N',
               'pDim', sDim,
               'pHierarchy', '',
               'pAttr', 'Region' );


ExecuteProcess( 'System - Dimension - Create Hierarchy from Attribute',
               'pConfirm', 'Y',
               'pEmail', 'N',
               'pDim', sDim,
               'pHierarchy', '',
               'pAttr', 'Country' );

ExecuteProcess( 'System - Dimension - Create Hierarchy from Attribute',
               'pConfirm', 'Y',
               'pEmail', 'N',
               'pDim', sDim,
               'pHierarchy', '',
               'pAttr', 'Type' );

ExecuteProcess( 'System - Dimension - Create Hierarchy from Attribute',
               'pConfirm', 'Y',
               'pEmail', 'N',
               'pDim', sDim,
               'pHierarchy', '',
               'pAttr', 'Division' );


###### PUBLISH PROCESS INFORMATION ######
sEndTime = TIMST( Now() , '\Y-\m-\d \h:\i:\s');
sEndValue = Now();
sProcess = GetProcessName();
If(SUBST( TM1User(), 1, 2 ) @= 'R*' % DIMIX( '}Clients', TM1User() ) = 0);
    sUser = TM1User();
else;
    sUser = ATTRS( '}Clients', TM1User(), '}TM1_DefaultDisplayValue' );
endif;
sErrorFile = GetProcessErrorFilename();
sCompletionTime = TIMST(sEndValue - sStartValue, '\i m \s s');

#### Edit This
sParameters = 'pConfirm='|pConfirm|', pEmail='|pEmail;   

##### Insert Time Record #############################
sDim = 'Time Processes';
DimensionElementInsertDirect(sDim, '', sEndTime, 'N' );
##########################################################
sCube = 'System - Process Information';
CellPutN( nRecords, sCube, sEndTime, sProcess, 'Records Processed' );
CellPutS( sStartTime, sCube, sEndTime, sProcess, 'Start Time' );
CellPutS( sEndTime, sCube, sEndTime, sProcess, 'End Time' );
CellPutS( sUser, sCube, sEndTime, sProcess, 'Executed By' );
CellPutS( sStatus, sCube, sEndTime, sProcess, 'Execution Status' );
CellPutS( 'Process', sCube, sEndTime, sProcess, 'Updated From' );
CellPutS( sCompletionTime, sCube, sEndTime, sProcess, 'Completion Time' );
CellPutS( sErrorFile, sCube, sEndTime, sProcess, 'Server Log Error' );
CellPutS( sParameters, sCube, sEndTime, sProcess, 'Parameters Used' );
sCube = 'System - Documentation - Model';
CellPutS( sCompletionTime, sCube, 'Process: '|sProcess, 'Process Last Run Time' );
CellPutS( sEndTime, sCube, 'Process: '|sProcess, 'Process Last Run' );
########################################



###### SEND EMAIL TO ADMIN OR USER ######
sEmailProcess = CellGets('System - Parameters', 'Email TI Process', 'String' );
sTM1User = TM1User();
iCalledByChore = if (SUBST(sTM1User, 1, 2) @= 'R*', 1, 0);
if (pEmail @= 'Y');
    iSendEmail = 0;

    if (iCalledByChore = 0);
        iSendEmail = 1;
    elseif (nError > 0);
        iSendEmail = 1;
    endif;

    if (iSendEmail = 1);
        # if non-native security is being used, try and use the nicely formatted name in preference to the long unique code.
        if (DimensionExists('}ElementAttributes_}Clients') = 1);
            if (dimix('}ElementAttributes_}Clients', '}TM1_DefaultDisplayValue') > 0 & dimix('}Clients', TM1User) > 0);
                sUserNiceName = trim(ATTRS('}Clients', sTM1User, '}TM1_DefaultDisplayValue'));
                if (sUserNiceName @<> ''); 	sTM1User = sUserNiceName;		endif;
            endif;
        endif;

        # The result of this process is sent to the calling user when run by hand or to admin when run by a chore.
        if (iCalledByChore = 1); 
            sAdmin1Email = CellGetS( 'System - Parameters', 'Administrator 1 Email', 'String' );
            sAdmin2Email = CellGetS( 'System - Parameters', 'Administrator 2 Email', 'String' );
            sAdmin3Email = CellGetS( 'System - Parameters', 'Administrator 3 Email', 'String' );
        Else;
            IF(CellGetS( 'System - Parameters - User', sTM1User, 'Email Is Valid', 'String') @= 'Yes');
                sRecipient = CellGetS( 'System - Parameters - User', sTM1User, 'Email', 'String' );
            else;
                sAdmin1Email = CellGetS( 'System - Parameters', 'Administrator 1 Email', 'String' );
                sAdmin2Email = CellGetS( 'System - Parameters', 'Administrator 2 Email', 'String' );
                sAdmin3Email = CellGetS( 'System - Parameters', 'Administrator 3 Email', 'String' );  
            endif;
        endif;

        sCC = 'X';
        sBCC = 'X';

        if (nError = 0); 
            sSubject = 'Process Success - '|sProcess; 
            sMessageStatus = '<font color="green">successfully</font>';
        Else;
            sSubject = 'Process Error - '|sProcess;
            sMessageStatus = '<font color="red">with errors</font> ';
        Endif; 

        if 	(lower(sTM1User) @= 'admin');	sUsernameToDisplay = 'Admin';
        elseif 	(iCalledByChore = 1);		sUsernameToDisplay = 'a Chore [' | subst(sTM1User, 3, long(sTM1User) - 2) | ']';
        else;
            sUsernameToDisplay = trim(CellGetS('System - Parameters - User', Tm1User(), 'Full Name', 'String' ));
            if ( sUsernameToDisplay @= '' ); sUsernameToDisplay = sTM1User;  endif;
        endif;

        sEmailMessage = '<p>Dear '|sUsernameToDisplay|'</p><p>PROCESS: '|sProcess|' has completed '|sMessageStatus|'</p><p>The following parameters were used - '|sParameters|'</p>';
        sEmailMessage = sEmailMessage | '<b>' | GetProcessName() | '</b> was run at ' | TIMST(NOW(), '\h:\i:\s') | ' by ' | sUsernameToDisplay | '.<br>';
        sEmailMessage = sEmailMessage | '<p>   </p>';

        sLogFilenameWithoutExtension = GetProcessName | ' EmailerLog';
        sAttachment = 'X';

        # Now call the process that sends the email.
        if (iCalledByChore = 1);
            if (sAdmin1Email @<> ''); 
                vResult = ExecuteProcess(sEmailProcess, 'pRecipient', sAdmin1Email, 'pCC', sCC, 'pBCC', sBCC, 'pSubject', sSubject, 
                                         'pBody', sEmailMessage, 'pLogFilenameWithoutExtension', sLogFilenameWithoutExtension, 'pAttachment', sAttachment);
            endif;
            if (sAdmin2Email @<> ''); 
                vResult = ExecuteProcess(sEmailProcess, 'pRecipient', sAdmin2Email, 'pCC', sCC, 'pBCC', sBCC, 'pSubject', sSubject, 
                                         'pBody', sEmailMessage, 'pLogFilenameWithoutExtension', sLogFilenameWithoutExtension, 'pAttachment', sAttachment); 
            endif;
            if (sAdmin3Email @<> ''); 
                vResult = ExecuteProcess(sEmailProcess, 'pRecipient', sAdmin3Email, 'pCC', sCC, 'pBCC', sBCC, 'pSubject', sSubject, 
                                         'pBody', sEmailMessage, 'pLogFilenameWithoutExtension', sLogFilenameWithoutExtension, 'pAttachment', sAttachment); 
            endif;
        Else;
            vResult = ExecuteProcess(sEmailProcess, 'pRecipient', sRecipient, 'pCC', sCC, 'pBCC', sBCC, 'pSubject', sSubject, 
                                     'pBody', sEmailMessage, 'pLogFilenameWithoutExtension', sLogFilenameWithoutExtension, 'pAttachment', sAttachment);
        endif;
    endif;
endif;


if (nError > 0); 
    ItemReject(sStatus); 
endif;
#endregion