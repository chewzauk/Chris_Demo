#region Prolog

sDim='Position';
sSrcView=GetProcessName();

#Create Subset


H1='Team';
H2='Manager';
H3='Cost Centre';
H4='Location';
H5='Company';
H6='Position Worker Type';
H7='Worker Type';
H8='Position Status';
H9='Grade';

HierarchyDestroy(sDim, 'By '|H1);
HierarchyDestroy(sDim, 'By '|H2);
HierarchyDestroy(sDim, 'By '|H3);
HierarchyDestroy(sDim, 'By '|H4);
HierarchyDestroy(sDim, 'By '|H5);
HierarchyDestroy(sDim, 'By '|H6);
HierarchyDestroy(sDim, 'By '|H7);
HierarchyDestroy(sDim, 'By '|H8);
HierarchyDestroy(sDim, 'By '|H9);

#Check if Hierarchy Exists, create if not

if(HierarchyExists( sDim, 'By '|H1 )=0);
    HierarchyCreate( sDim, 'By '|H1 );
endif;

if(HierarchyExists( sDim, 'By '|H2 )=0);
    HierarchyCreate( sDim, 'By '|H2 );
endif;

if(HierarchyExists( sDim, 'By '|H3 )=0);
    HierarchyCreate( sDim, 'By '|H3 );
endif;

if(HierarchyExists( sDim, 'By '|H4 )=0);
    HierarchyCreate( sDim, 'By '|H4 );
endif;

if(HierarchyExists( sDim, 'By '|H5 )=0);
    HierarchyCreate( sDim, 'By '|H5 );
endif;

if(HierarchyExists( sDim, 'By '|H6 )=0);
    HierarchyCreate( sDim, 'By '|H6 );
endif;

if(HierarchyExists( sDim, 'By '|H7)=0);
    HierarchyCreate( sDim, 'By '|H7 );
endif;

if(HierarchyExists( sDim, 'By '|H8)=0);
    HierarchyCreate( sDim, 'By '|H8 );
endif;

if(HierarchyExists( sDim, 'By '|H9)=0);
    HierarchyCreate( sDim, 'By '|H9 );
endif;

#Unwind hierarchy to recreate


ExecuteProcess( '}bedrock.hier.unwind', 'pDim', sDim, 'pRecursive', 1, 'pHier', 'By '|H1 );
 ExecuteProcess( '}bedrock.hier.unwind', 'pDim', sDim, 'pRecursive', 1, 'pHier', 'By '|H2 );
 ExecuteProcess( '}bedrock.hier.unwind', 'pDim', sDim, 'pRecursive', 1, 'pHier', 'By '|H3 );
 ExecuteProcess( '}bedrock.hier.unwind', 'pDim', sDim, 'pRecursive', 1, 'pHier', 'By '|H4 );
 ExecuteProcess( '}bedrock.hier.unwind', 'pDim', sDim, 'pRecursive', 1, 'pHier', 'By '|H5 );
 ExecuteProcess( '}bedrock.hier.unwind', 'pDim', sDim, 'pRecursive', 1, 'pHier', 'By '|H6 );
 ExecuteProcess( '}bedrock.hier.unwind', 'pDim', sDim, 'pRecursive', 1, 'pHier', 'By '|H7 );
 ExecuteProcess( '}bedrock.hier.unwind', 'pDim', sDim, 'pRecursive', 1, 'pHier', 'By '|H8 );
 ExecuteProcess( '}bedrock.hier.unwind', 'pDim', sDim, 'pRecursive', 1, 'pHier', 'By '|H9 );




#endregion
#region Metadata


#H1

sHParent=ATTRS( sDim, vEL, H1 );

if(sHParent @='');
    sHParent='Unknown '|H1;
endif;


HierarchyElementInsert( sDim, 'By '|H1, '', 'Total by '|H1, 'C' );
HierarchyElementInsert( sDim, 'By '|H1, '', sHParent, 'C' );

HierarchyElementComponentAdd( sDim, 'By '|H1, 'Total by '|H1, sHParent, 1 );
HierarchyElementComponentAdd( sDim, 'By '|H1, sHParent,  vEl, 1 );


