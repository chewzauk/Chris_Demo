#region Data


sDesc = Maconomy_Global_COA_code_Number|' - '|Maconomy_Global_COA_code_description;
sType = If(PL_or_BS @= 'Balance Sheet', 'BS', 'PL');

AttrPutS( sDesc, sDim, Maconomy_Global_COA_code_Number, 'CodeDescription');
AttrPutS( Maconomy_Global_COA_code_description, sDim, Maconomy_Global_COA_code_Number, 'Description');
AttrPutS( Maconomy_Global_COA_code_description, sDim, Maconomy_Global_COA_code_Number, 'Name');
AttrPutS( sType, sDim, Maconomy_Global_COA_code_Number, 'AccountType');

If(PL_or_BS @= 'P & L' );
AttrPutS( sDesc, sDim1, Maconomy_Global_COA_code_Number, 'CodeDescription');
AttrPutS( Maconomy_Global_COA_code_description, sDim1, Maconomy_Global_COA_code_Number, 'Description');
AttrPutS( Maconomy_Global_COA_code_description, sDim1, Maconomy_Global_COA_code_Number, 'Name');
AttrPutS( sType, sDim1, Maconomy_Global_COA_code_Number, 'AccountType');
endif;

If(PL_or_BS @= 'Balance Sheet' );
AttrPutS( sDesc, sDim2, Maconomy_Global_COA_code_Number, 'CodeDescription');
AttrPutS( Maconomy_Global_COA_code_description, sDim2, Maconomy_Global_COA_code_Number, 'Description');
AttrPutS( Maconomy_Global_COA_code_description, sDim2, Maconomy_Global_COA_code_Number, 'Name');
AttrPutS( sType, sDim2, Maconomy_Global_COA_code_Number, 'AccountType');
endif;

#endregion
#region Epilog

### Accounts dimension
### Create TB Check rollup
DimensionElementComponentAddDirect( sDim, 'TB Check', 'Net Assets / (Liabilities)', 1 );
DimensionElementComponentAddDirect( sDim, 'TB Check', 'Total Equity', -1 );
### Add lines for Other Equity for FX Calc
DimensionElementComponentAddDirect( sDim, sFXOtherEquity, 'Share Capital', 1 );
DimensionElementComponentAddDirect( sDim, sFXOtherEquity, 'Capital Contribution', 1 );
DimensionElementComponentAddDirect( sDim, sFXOtherEquity, 'Share Based Payment Reserve', 1 );
DimensionElementComponentAddDirect( sDim, sFXOtherEquity, 'Share Premium', 1 );
DimensionElementComponentAddDirect( sDim, sFXOtherEquity, 'Other Reserves', 1 );

### Add lines for Net Assets Less Cash
DimensionElementComponentAddDirect( sDim, sAssetsLessCash, 'Intercompany', 1 );
DimensionElementComponentAddDirect( sDim, sAssetsLessCash, 'Fixed Assets', 1 );
DimensionElementComponentAddDirect( sDim, sAssetsLessCash, 'Current Liabilities', 1 );
DimensionElementComponentAddDirect( sDim, sAssetsLessCash, 'Provisions', 1 );
DimensionElementComponentAddDirect( sDim, sAssetsLessCash, 'Trade debtors (Excluding I/C)', 1 );
DimensionElementComponentAddDirect( sDim, sAssetsLessCash, 'Doubtful Debt Provision', 1 );
DimensionElementComponentAddDirect( sDim, sAssetsLessCash, 'Debit WIP', 1 );
DimensionElementComponentAddDirect( sDim, sAssetsLessCash, 'Accrued Income', 1 );
DimensionElementComponentAddDirect( sDim, sAssetsLessCash, 'Prepayments', 1 );
DimensionElementComponentAddDirect( sDim, sAssetsLessCash, 'Other Debtors', 1 );
DimensionElementComponentAddDirect( sDim, sAssetsLessCash, 'Senior Capital Advance', 1 );
DimensionElementComponentAddDirect( sDim, sAssetsLessCash, 'Withholding tax', 1 );
DimensionElementComponentAddDirect( sDim, sAssetsLessCash, 'Deferred tax', 1 );
DimensionElementComponentAddDirect( sDim, sAssetsLessCash, 'Interest Prepayment', 1 );


### Accounts - Balance sheet dimensions
### Create TB Check rollup
DimensionElementComponentAddDirect( sDim2, 'TB Check', 'Net Assets / (Liabilities)', 1 );
DimensionElementComponentAddDirect( sDim2, 'TB Check', 'Total Equity', -1 );
### Add lines for Other Equity for FX Calc
DimensionElementComponentAddDirect( sDim2, sFXOtherEquity, 'Share Capital', 1 );
DimensionElementComponentAddDirect( sDim2, sFXOtherEquity, 'Capital Contribution', 1 );
DimensionElementComponentAddDirect( sDim2, sFXOtherEquity, 'Share Based Payment Reserve', 1 );
DimensionElementComponentAddDirect( sDim2, sFXOtherEquity, 'Share Premium', 1 );
DimensionElementComponentAddDirect( sDim2, sFXOtherEquity, 'Other Reserves', 1 );

### Add lines for Net Assets Less Cash
DimensionElementComponentAddDirect( sDim2, sAssetsLessCash, 'Intercompany', 1 );
DimensionElementComponentAddDirect( sDim2, sAssetsLessCash, 'Fixed Assets', 1 );
DimensionElementComponentAddDirect( sDim2, sAssetsLessCash, 'Current Liabilities', 1 );
DimensionElementComponentAddDirect( sDim2, sAssetsLessCash, 'Provisions', 1 );
DimensionElementComponentAddDirect( sDim2, sAssetsLessCash, 'Trade debtors (Excluding I/C)', 1 );
DimensionElementComponentAddDirect( sDim2, sAssetsLessCash, 'Doubtful Debt Provision', 1 );
DimensionElementComponentAddDirect( sDim2, sAssetsLessCash, 'Debit WIP', 1 );
DimensionElementComponentAddDirect( sDim2, sAssetsLessCash, 'Accrued Income', 1 );
DimensionElementComponentAddDirect( sDim2, sAssetsLessCash, 'Prepayments', 1 );
DimensionElementComponentAddDirect( sDim2, sAssetsLessCash, 'Other Debtors', 1 );
DimensionElementComponentAddDirect( sDim2, sAssetsLessCash, 'Senior Capital Advance', 1 );
DimensionElementComponentAddDirect( sDim2, sAssetsLessCash, 'Withholding tax', 1 );
DimensionElementComponentAddDirect( sDim2, sAssetsLessCash, 'Deferred tax', 1 );
DimensionElementComponentAddDirect( sDim2, sAssetsLessCash, 'Interest Prepayment', 1 );

if (nError=0); 
    sStatus = 'Success'; 
endif;

###### PUBLISH PROCESS INFORMATION ######
sEndTime = TIMST( Now() , '\Y-\m-\d \h:\i:\s');
sEndValue = Now();
sProcess = GetProcessName();
If(SUBST( TM1User(), 1, 2 ) @= 'R*' % DIMIX( '}Clients', TM1User() ) = 0);
    sUser = TM1User();
else;
    sUser = ATTRS( '}Clients', TM1User(), '}TM1_DefaultDisplayValue' );
endif;
sErrorFile = GetProcessErrorFilename();
sCompletionTime = TIMST(sEndValue - sStartValue, '\i m \s s');

#### Edit This
sParameters = 'pConfirm='|pConfirm;   

##### Insert Time Record #############################
sDim = 'Time Processes';
DimensionElementInsertDirect(sDim, '', sEndTime, 'N' );
##########################################################
sCube = 'System - Process Information';
CellPutN( nRecords, sCube, sEndTime, sProcess, 'Records Processed' );
CellPutS( sStartTime, sCube, sEndTime, sProcess, 'Start Time' );
CellPutS( sEndTime, sCube, sEndTime, sProcess, 'End Time' );
CellPutS( sUser, sCube, sEndTime, sProcess, 'Executed By' );
CellPutS( sStatus, sCube, sEndTime, sProcess, 'Execution Status' );
CellPutS( 'Process', sCube, sEndTime, sProcess, 'Updated From' );
CellPutS( sCompletionTime, sCube, sEndTime, sProcess, 'Completion Time' );
CellPutS( sErrorFile, sCube, sEndTime, sProcess, 'Server Log Error' );
CellPutS( sParameters, sCube, sEndTime, sProcess, 'Parameters Used' );
sCube = 'System - Documentation - Model';
CellPutS( sCompletionTime, sCube, 'Process: '|sProcess, 'Process Last Run Time' );
CellPutS( sEndTime, sCube, 'Process: '|sProcess, 'Process Last Run' );
########################################




if (nError > 0); 
    ItemReject(sStatus); 
endif;
#endregion