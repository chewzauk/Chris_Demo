#region Prolog

############# VARIABLES FOR PROCESS INFORMATION
sStartTime = TIMST( Now() , '\Y-\m-\d \h:\i:\s');
sStartValue = Now();
nRecords = 0;
sStatus = '';
nError = 0;
##############################################

####### SET PROCESSES DOCUMENTATION #####
#### Edit variables below
sDescription = 'The process is a default process to be used as the base for all other processes developed'; 
sDeveloper = 'Sempre: Shane James';    
sSource = 'Source'; 
sSourceType = 'Source Type'; 
sTarget = 'Accounts'; 
sTargetType = 'Target Type'; 

sCube = 'System - Documentation - Model';
If(DIMIX('Documentation' , 'Process: '|GetProcessname() ) = 0);
    ExecuteProcess('System - Documentation - Update or Create Documentation Dimensions', 'pIncludeControlObjects', 'N', 'pDocumentElements', 'N' );
endif;
If(CubeExists( sCube ) > 0);
    CellPutS( sDescription, sCube, 'Process: '|GetProcessname(), 'Description' );
    CellPutS( sSource, sCube, 'Process: '|GetProcessname(), 'Process Source' );
    CellPutS( sTarget, sCube, 'Process: '|GetProcessname(), 'Process Target' );
    CellPutS( sSourceType, sCube, 'Process: '|GetProcessname(), 'Process Source Type' );
    CellPutS( sTargetType, sCube, 'Process: '|GetProcessname(), 'Process Target Type' );
    CellPutS( sDeveloper, sCube, 'Process: '|GetProcessname(), 'Developer' );
Endif;
#########################################

if (pConfirm @= 'N');
    sStatus = 'Process execution not confirmed';
    nError=1;
    ProcessBreak; 
endif;

sDim = 'Accounts';
sDim1 = 'Accounts - Profit and Loss';
sDim2 = 'Accounts - Balance Sheet';

if (1=0); 

    ExecuteProcess( '}bedrock.hier.unwind', 'pLogOutput', 1,
                   'pDim', sDim , 'pHier', sDim, 'pConsol', '*',
                   'pRecursive', 1, 'pDelim', '&'
                  );

    ExecuteProcess( '}bedrock.hier.unwind', 'pLogOutput', 1,
                   'pDim', sDim1 , 'pHier', sDim1, 'pConsol', '*',
                   'pRecursive', 1, 'pDelim', '&'
                  );

    ExecuteProcess( '}bedrock.hier.unwind', 'pLogOutput', 1,
                   'pDim', sDim2 , 'pHier', sDim2, 'pConsol', '*',
                   'pRecursive', 1, 'pDelim', '&'
                  );
else; 
    sDim = 'Accounts';
    DimensionDeleteAllElements(sDim);
    DimensionDeleteAllElements(sDim1);
    DimensionDeleteAllElements(sDim2);
endif;

sOtherHierarchiesGrandTotal = 'Other Hierarchies';
sMTCFGrandparent = 'MTCF Mappings';
sFXOtherEquity = 'Other Equity for FX Calc';
sAssetsLessCash = 'Net Assets/Liabilities less Cash';


DimensionElementInsert( sDim, '', 'TB Check', 'C' );
DimensionElementInsert( sDim, '', 'EBITDA %', 'N' );
DimensionElementInsert( sDim, '', 'Personnel % OI', 'N' );
DimensionElementInsert( sDim, '', 'Net Working Capital', 'C' );
DimensionElementInsert( sDim, '', 'Net Working Capital (excl Intercompany)', 'C' );
DimensionElementInsert( sDim, '', sOtherHierarchiesGrandTotal, 'C' );
DimensionElementInsert( sDim, '', sFXOtherEquity, 'C' );
DimensionElementInsert( sDim, '', sAssetsLessCash, 'C' );
DimensionElementComponentAdd( sDim, sOtherHierarchiesGrandTotal, sFXOtherEquity, 0 );
DimensionElementComponentAdd( sDim, sOtherHierarchiesGrandTotal, 'Net Working Capital', 0 );
DimensionElementComponentAdd( sDim, sOtherHierarchiesGrandTotal, 'Net Working Capital (excl Intercompany)', 0 );
DimensionElementComponentAdd( sDim, sOtherHierarchiesGrandTotal, sAssetsLessCash, 0 );

DimensionElementInsert( sDim2, '', 'TB Check', 'C' );
DimensionElementInsert( sDim2, '', 'Net Working Capital', 'C' );
DimensionElementInsert( sDim2, '', 'Net Working Capital (excl Intercompany)', 'C' );
