DimensionElementComponentAdd( sDim2, sOtherHierarchiesGrandTotal, 'Net Working Capital', 0 );
DimensionElementComponentAdd( sDim2, sOtherHierarchiesGrandTotal, 'Net Working Capital (excl Intercompany)', 0 );
DimensionElementComponentAdd( sDim2, sOtherHierarchiesGrandTotal, sAssetsLessCash, 0 );

AttrInsert( sDim, '', 'AccountType', 'S' );
AttrInsert( sDim, '', 'Name', 'S' );
AttrInsert( sDim, '', 'CodeDescription', 'A' );
AttrInsert( sDim, '', 'Description', 'A' );

AttrInsert( sDim1, '', 'AccountType', 'S' );
AttrInsert( sDim1, '', 'Name', 'S' );
AttrInsert( sDim1, '', 'CodeDescription', 'A' );
AttrInsert( sDim1, '', 'Description', 'A' );

