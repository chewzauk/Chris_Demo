#region Prolog

############# VARIABLES FOR PROCESS INFORMATION
sStartTime = TIMST( Now() , '\Y-\m-\d \h:\i:\s');
sStartValue = Now();
nRecords = 0;
sStatus = '';
nError = 0;
##############################################

####### SET PROCESESS DESCRIPTION #####
sDescription = 'Clears the process logs for a specified process or all processes';
sDeveloper = 'Sempre: Shane James';
sSource = 'Manual';
sSourceType = 'Parameters';
sTarget = 'System - Process Info';
sTargetType = 'Cube';
sCube = 'System - Documentation - Model';
If(DIMIX('Documentation' , 'Process: '|GetProcessname() ) = 0);
    ExecuteProcess('System - Documentation - Update or Create Documentation Dimensions', 'pIncludeControlObjects', 'N', 'pDocumentElements', 'N' );
endif;
If(CubeExists( sCube ) > 0);
    CellPutS( sDescription, sCube, 'Process: '|GetProcessname(), 'Description' );
    CellPutS( sSource, sCube, 'Process: '|GetProcessname(), 'Process Source' );
    CellPutS( sTarget, sCube, 'Process: '|GetProcessname(), 'Process Target' );
    CellPutS( sSourceType, sCube, 'Process: '|GetProcessname(), 'Process Source Type' );
    CellPutS( sTargetType, sCube, 'Process: '|GetProcessname(), 'Process Target Type' );
    CellPutS( sDeveloper, sCube, 'Process: '|GetProcessname(), 'Developer' );
Endif;
#########################################

if (pConfirm @= 'N');
    sStatus = 'Process execution not confirmed';
    nError = 1;
    ProcessBreak; 
endif;

sDim1 = '}Processes';
sDim2 = 'Time Processes';
sCube = 'System - Process Information';
sSub = '}VZOProcessInfo';
sView = '}VZOProcessInfo';

if (pConfirm @<> 'Y'); 
    sStatus = 'This process did not execute. Please enter Y to confirm.'; 
    nError = 1;
    ProcessBreak;
endif;

if (pKeepLast30Days @= 'N'); 
    if (pProcess @<> ''); 
        #### Error Check
        if (DIMIX( sDim1, pProcess )=0); 
            sStatus = 'This process does not exist, please run again with correct name'; 
            nError = 1;
            ProcessBreak;
        endif;
        #### Create Subsets
        If(SubsetExists(sDim1, sSub) = 0, SubsetCreate(sDim1, sSub),0);

        ### Delete existing elements
        SubsetDeleteAllElements(sDim1, sSub);

        ### Load data into new subset
        SubsetElementInsert(sDim1, sSub, pProcess, 1);

        ### Create View
        If(Viewexists(sCube, sView) = 0, ViewCreate(sCube, sView), 0);
        ViewSubsetAssign(sCube, sView, sDim1, sSub);  
        ViewZeroOut( sCube, sView );
        sStatus = pProcess|' - Logging data cleared';
    endif;

    if (pProcess @= '');
        DimensionDeleteAllElements( sDim2 );
        sStatus = 'All Logging data cleared';
    endif; 
endif;


if (pKeepLast30Days @= 'Y'); 
    nDimSize = DIMSIZ( sDim2 );
    while (nDimSize>0);
        sElement = ElementName( sDim2, sDim2, nDimSize );
        sNow = ATTRS('Date',  TIMST( Now() , '\Y-\m-\d'), 'Index');
        n30daysPriorIndex = StringToNumber( sNow ) - 30;
        nElementIndex = StringToNumber(ATTRS('Date', SUBST(sElement,1,10), 'Index'));
        if (nElementIndex < n30daysPriorIndex); 
            DimensionElementDelete( sDim2, sElement ) ; 
        endif;
        nDimSize = nDimSize-1; 
    end;

endif;

#endregion
#region Epilog


###### PUBLISH PROCESS INFORMATION ######
sEndTime = TIMST( Now() , '\Y-\m-\d \h:\i:\s');
sEndValue = Now();
sProcess = GetProcessName();
If(SUBST( TM1User(), 1, 2 ) @= 'R*' % DIMIX( '}Clients', TM1User() ) = 0);
    sUser = TM1User();
else;
    sUser = ATTRS( '}Clients', TM1User(), '}TM1_DefaultDisplayValue' );
endif;
sErrorFile = GetProcessErrorFilename();
sCompletionTime = TIMST(sEndValue - sStartValue, '\i m \s s');
sParameters = 'pConfirm='|pConfirm|', pEmail='|pEmail|', pConfirm = '|pConfirm|', pProcess = '|pProcess|' ,pKeepLast30Days='|pKeepLast30Days;
##### Insert Time Record #############################
sDim = 'Time Processes';
DimensionElementInsertDirect(sDim, '', sEndTime, 'N' );
##########################################################
sCube = 'System - Process Information';
CellPutN( nRecords, sCube, sEndTime, sProcess, 'Records Processed' );
CellPutS( sStartTime, sCube, sEndTime, sProcess, 'Start Time' );
CellPutS( sEndTime, sCube, sEndTime, sProcess, 'End Time' );
CellPutS( sUser, sCube, sEndTime, sProcess, 'Executed By' );
CellPutS( sStatus, sCube, sEndTime, sProcess, 'Execution Status' );
CellPutS( 'Process', sCube, sEndTime, sProcess, 'Updated From' );
CellPutS( sCompletionTime, sCube, sEndTime, sProcess, 'Completion Time' );
CellPutS( sErrorFile, sCube, sEndTime, sProcess, 'Server Log Error' );
CellPutS( sParameters, sCube, sEndTime, sProcess, 'Parameters Used' );
sCube = 'System - Documentation - Model';
CellPutS( sCompletionTime, sCube, 'Process: '|sProcess, 'Process Last Run Time' );
CellPutS( sEndTime, sCube, 'Process: '|sProcess, 'Process Last Run' );
########################################



###### SEND EMAIL TO ADMIN OR USER ######
sEmailProcess = CellGets('System - Parameters', 'Email TI Process', 'String' );
sTM1User = TM1User();
iCalledByChore = if (SUBST(sTM1User, 1, 2) @= 'R*', 1, 0);
if (pEmail @= 'Y');
    iSendEmail = 0;

    if (iCalledByChore = 0);
        iSendEmail = 1;
    elseif (nError > 0);
        iSendEmail = 1;
    endif;

    if (iSendEmail = 1);
        # if non-native security is being used, try and use the nicely formatted name in preference to the long unique code.
        if (DimensionExists('}ElementAttributes_}Clients') = 1);
            if (dimix('}ElementAttributes_}Clients', '}TM1_DefaultDisplayValue') > 0 & dimix('}Clients', TM1User) > 0);
                sUserNiceName = trim(ATTRS('}Clients', sTM1User, '}TM1_DefaultDisplayValue'));
                if (sUserNiceName @<> ''); 	sTM1User = sUserNiceName;		endif;
            endif;
        endif;

        # The result of this process is sent to the calling user when run by hand or to admin when run by a chore.
        if (iCalledByChore = 1); 
            sAdmin1Email = CellGetS( 'System - Parameters', 'Administrator 1 Email', 'String' );
            sAdmin2Email = CellGetS( 'System - Parameters', 'Administrator 2 Email', 'String' );
            sAdmin3Email = CellGetS( 'System - Parameters', 'Administrator 3 Email', 'String' );
        Else;
            IF(CellGetS( 'System - Parameters - User', sTM1User, 'Email Is Valid', 'String') @= 'Yes');
                sRecipient = CellGetS( 'System - Parameters - User', sTM1User, 'Email', 'String' );
            else;
                sAdmin1Email = CellGetS( 'System - Parameters', 'Administrator 1 Email', 'String' );
                sAdmin2Email = CellGetS( 'System - Parameters', 'Administrator 2 Email', 'String' );
                sAdmin3Email = CellGetS( 'System - Parameters', 'Administrator 3 Email', 'String' );  
            endif;
        endif;

        sCC = 'X';
        sBCC = 'X';

        if (nError = 0); 
            sSubject = 'Process Success - '|sProcess; 
            sMessageStatus = '<font color="green">successfully</font>';
        Else;
            sSubject = 'Process Error - '|sProcess;
            sMessageStatus = '<font color="red">with errors</font> ';
        Endif; 

        if 	(lower(sTM1User) @= 'admin');	sUsernameToDisplay = 'Admin';
        elseif 	(iCalledByChore = 1);		sUsernameToDisplay = 'a Chore [' | subst(sTM1User, 3, long(sTM1User) - 2) | ']';
        else;
            sUsernameToDisplay = trim(CellGetS('System - Parameters - User', Tm1User(), 'Full Name', 'String' ));
            if ( sUsernameToDisplay @= '' ); sUsernameToDisplay = sTM1User;  endif;
        endif;

        sEmailMessage = '<p>Dear '|sUsernameToDisplay|'</p><p>PROCESS: '|sProcess|' has completed '|sMessageStatus|'</p><p>The following parameters were used - '|sParameters|'</p>';
        sEmailMessage = sEmailMessage | '<b>' | GetProcessName() | '</b> was run at ' | TIMST(NOW(), '\h:\i:\s') | ' by ' | sUsernameToDisplay | '.<br>';
        sEmailMessage = sEmailMessage | '<p>   </p>';

        sLogFilenameWithoutExtension = GetProcessName | ' EmailerLog';
        sAttachment = 'X';

        # Now call the process that sends the email.
        if (iCalledByChore = 1);
            if (sAdmin1Email @<> ''); 
                vResult = ExecuteProcess(sEmailProcess, 'pRecipient', sAdmin1Email, 'pCC', sCC, 'pBCC', sBCC, 'pSubject', sSubject, 
                                         'pBody', sEmailMessage, 'pLogFilenameWithoutExtension', sLogFilenameWithoutExtension, 'pAttachment', sAttachment);
            endif;
            if (sAdmin2Email @<> ''); 
                vResult = ExecuteProcess(sEmailProcess, 'pRecipient', sAdmin2Email, 'pCC', sCC, 'pBCC', sBCC, 'pSubject', sSubject, 
                                         'pBody', sEmailMessage, 'pLogFilenameWithoutExtension', sLogFilenameWithoutExtension, 'pAttachment', sAttachment); 
            endif;
            if (sAdmin3Email @<> ''); 
                vResult = ExecuteProcess(sEmailProcess, 'pRecipient', sAdmin3Email, 'pCC', sCC, 'pBCC', sBCC, 'pSubject', sSubject, 
                                         'pBody', sEmailMessage, 'pLogFilenameWithoutExtension', sLogFilenameWithoutExtension, 'pAttachment', sAttachment); 
            endif;
        Else;
            vResult = ExecuteProcess(sEmailProcess, 'pRecipient', sRecipient, 'pCC', sCC, 'pBCC', sBCC, 'pSubject', sSubject, 
                                     'pBody', sEmailMessage, 'pLogFilenameWithoutExtension', sLogFilenameWithoutExtension, 'pAttachment', sAttachment);
        endif;
    endif;
endif;


if (nError > 0); 
    ItemReject(sStatus); 
endif;

if (nError > 0);
    ItemReject(sStatus);
endif;
#endregion