#region Prolog

############# VARIABLES FOR PROCESS INFORMATION
sStartTime = TIMST( Now() , '\Y-\m-\d \h:\i:\s');
sStartValue = Now();
nRecords = 0;
sStatus = '';
nError = 0;
##############################################

####### SET PROCESSES DOCUMENTATION #####
#### Edit variables below
sDescription = 'This setup up the monthend workflow by populating the start and deadline dates as well as the company constant for each company'; 
sDeveloper = 'Sempre: Shane James';    
sSource = 'Workflow Item'; 
sSourceType = 'Dimension'; 
sTarget = 'System - Workflow'; 
sTargetType = 'Cube'; 

sCube = 'System - Documentation - Model';
If(DIMIX('Documentation' , 'Process: '|GetProcessname() ) = 0);
    ExecuteProcess('System - Documentation - Update or Create Documentation Dimensions', 'pIncludeControlObjects', 'N', 'pDocumentElements', 'N' );
endif;
If(CubeExists( sCube ) > 0);
    CellPutS( sDescription, sCube, 'Process: '|GetProcessname(), 'Description' );
    CellPutS( sSource, sCube, 'Process: '|GetProcessname(), 'Process Source' );
    CellPutS( sTarget, sCube, 'Process: '|GetProcessname(), 'Process Target' );
    CellPutS( sSourceType, sCube, 'Process: '|GetProcessname(), 'Process Source Type' );
    CellPutS( sTargetType, sCube, 'Process: '|GetProcessname(), 'Process Target Type' );
    CellPutS( sDeveloper, sCube, 'Process: '|GetProcessname(), 'Developer' );
Endif;
#########################################

if (pConfirm @= 'N');
    sStatus = 'Process execution not confirmed';
    nError=1;
    ProcessBreak; 
endif;

sCube = 'System - Workflow';

if (DIMIX( 'Date Period', pPeriod ) = 0); 
    sStatus = 'The date is not a valid date';
    nError=nError+1;
    ProcessBreak;  
endif;
if (DIMIX( 'Company', pCompany ) = 0); 
    sStatus = 'The company is not a valid company';
    nError=nError+1;
    ProcessBreak;  
endif;
if (DIMIX( 'Workflow Item', pWorkflowItem ) = 0); 
    sStatus = 'This is not a valid workflow item';
    nError=nError+1;
    ProcessBreak;  
endif;
if (pType @<> 'Complete' & pType @<> 'Approve'); 
    sStatus = 'Only selection types of Complete or Approve are valid';
    nError=nError+1;
    ProcessBreak;   
endif;

sUser = CellGetS('System - Parameters - User', TM1User(), 'Full Name', 'String' );

sLockingSection = ATTRS('Workflow Item', pWorkflowItem, 'LockingSection');

If(ElementType( 'Company', 'Company', pCompany ) @= 'C');
    If(ElementLevel( 'Company', 'Company', pCompany ) = 1);
        nParentSize = ElementComponentCount( 'Company', 'Company', pCompany  );
        while (nParentSize > 0); 
            sCompany = ElementComponent( 'Company', 'Company', pCompany , nParentSize );
            if (pType @= 'Complete');
                if (ELLEV( 'Date Period', pPeriod ) > 0); 
                    CellPutProportionalSpread( 1, sCube, pPeriod, sCompany, pWorkflowItem, 'Completion Status Value' );
                else;
                    CellPutN( 1, sCube, pPeriod, sCompany, pWorkflowItem, 'Completion Status Value' ); 
                endif;
                CellPutS( sUser, sCube, pPeriod, sCompany, pWorkflowItem, 'Completed By' );
                sDate = DimensionElementPrincipalName('Date', TIMST( Now() , '\d-\m-\Y'));
                CellPutS( sDate, sCube, pPeriod, sCompany, pWorkflowItem, 'Completion Date' );
            endif;
            if (pType @= 'Approve');
                CellPutN( 1, sCube, pPeriod, sCompany, pWorkflowItem, 'Approval value' );
                CellPutS( sUser, sCube, pPeriod, sCompany, pWorkflowItem, 'Approved By' );
                sDate = DimensionElementPrincipalName('Date', TIMST( Now() , '\d-\m-\Y'));
                CellPutS( sDate, sCube, pPeriod, sCompany, pWorkflowItem, 'Approval Date' );
            endif;
            nParentSize = nParentSize -1;
        end;
    else;
        sStatus = 'You are trying to set a status of complete for a company higher than Operating Company Level. You can only set a complete status for Opco and Legal entity';
        nError=nError+1;
        ProcessBreak; 
    Endif;
else;
    if (pType @= 'Complete');
        if (ELLEV( 'Date Period', pPeriod ) > 0); 
            CellPutProportionalSpread( 1, sCube, pPeriod, pCompany, pWorkflowItem, 'Completion Status Value' );
        else;
            CellPutN( 1, sCube, pPeriod, pCompany, pWorkflowItem, 'Completion Status Value' ); 
        endif;
        CellPutS( sUser, sCube, pPeriod, pCompany, pWorkflowItem, 'Completed By' );
        sDate = DimensionElementPrincipalName('Date', TIMST( Now() , '\d-\m-\Y'));
        CellPutS( sDate, sCube, pPeriod, pCompany, pWorkflowItem, 'Completion Date' );
    endif;
    if (pType @= 'Approve');
        CellPutN( 1, sCube, pPeriod, pCompany, pWorkflowItem, 'Approval value' );
        CellPutS( sUser, sCube, pPeriod, pCompany, pWorkflowItem, 'Approved By' );
        sDate = DimensionElementPrincipalName('Date', TIMST( Now() , '\d-\m-\Y'));
        CellPutS( sDate, sCube, pPeriod, pCompany, pWorkflowItem, 'Approval Date' );
    endif;
Endif;

if (sLockingSection @<> ''); 
    CellPutS( 'Locked', 'System - Locking', pPeriod, 'Live Budget', sLockingSection, pCompany, 'Lock Status' ); 
endif;
#endregion
#region Epilog

if (nError=0); 
    sStatus = 'Success'; 
endif;

###### PUBLISH PROCESS INFORMATION ######
sEndTime = TIMST( Now() , '\Y-\m-\d \h:\i:\s');
sEndValue = Now();
sProcess = GetProcessName();
If(SUBST( TM1User(), 1, 2 ) @= 'R*' % DIMIX( '}Clients', TM1User() ) = 0);
    sUser = TM1User();
else;
    sUser = ATTRS( '}Clients', TM1User(), '}TM1_DefaultDisplayValue' );
endif;
sErrorFile = GetProcessErrorFilename();
sCompletionTime = TIMST(sEndValue - sStartValue, '\i m \s s');

#### Edit This
sParameters = 'pConfirm='|pConfirm|', pEmail='|pEmail|', pWorkflowItem='|pWorkflowItem|', pPeriod='|pPeriod|', pCompany='|pCompany|', pType='|pType;    

##### Insert Time Record #############################
sDim = 'Time Processes';
DimensionElementInsertDirect(sDim, '', sEndTime, 'N' );
##########################################################
sCube = 'System - Process Information';
CellPutN( nRecords, sCube, sEndTime, sProcess, 'Records Processed' );
CellPutS( sStartTime, sCube, sEndTime, sProcess, 'Start Time' );
CellPutS( sEndTime, sCube, sEndTime, sProcess, 'End Time' );
CellPutS( sUser, sCube, sEndTime, sProcess, 'Executed By' );
CellPutS( sStatus, sCube, sEndTime, sProcess, 'Execution Status' );
CellPutS( 'Process', sCube, sEndTime, sProcess, 'Updated From' );
CellPutS( sCompletionTime, sCube, sEndTime, sProcess, 'Completion Time' );
CellPutS( sErrorFile, sCube, sEndTime, sProcess, 'Server Log Error' );
CellPutS( sParameters, sCube, sEndTime, sProcess, 'Parameters Used' );
sCube = 'System - Documentation - Model';
CellPutS( sCompletionTime, sCube, 'Process: '|sProcess, 'Process Last Run Time' );
CellPutS( sEndTime, sCube, 'Process: '|sProcess, 'Process Last Run' );
########################################



###### SEND EMAIL TO ADMIN OR USER ######
sEmailProcess = CellGets('System - Parameters', 'Email TI Process', 'String' );
sTM1User = TM1User();
iCalledByChore = if (SUBST(sTM1User, 1, 2) @= 'R*', 1, 0);
if (pEmail @= 'Y');
    iSendEmail = 0;

    if (iCalledByChore = 0);
        iSendEmail = 1;
    elseif (nError > 0);
        iSendEmail = 1;
    endif;

    if (iSendEmail = 1);
        # if non-native security is being used, try and use the nicely formatted name in preference to the long unique code.
        if (DimensionExists('}ElementAttributes_}Clients') = 1);
            if (dimix('}ElementAttributes_}Clients', '}TM1_DefaultDisplayValue') > 0 & dimix('}Clients', TM1User) > 0);
                sUserNiceName = trim(ATTRS('}Clients', sTM1User, '}TM1_DefaultDisplayValue'));
                if (sUserNiceName @<> ''); 	sTM1User = sUserNiceName;		endif;
            endif;
        endif;

        # The result of this process is sent to the calling user when run by hand or to admin when run by a chore.
        if (iCalledByChore = 1); 
            sAdmin1Email = CellGetS( 'System - Parameters', 'Administrator 1 Email', 'String' );
            sAdmin2Email = CellGetS( 'System - Parameters', 'Administrator 2 Email', 'String' );
            sAdmin3Email = CellGetS( 'System - Parameters', 'Administrator 3 Email', 'String' );
        Else;
            IF(CellGetS( 'System - Parameters - User', sTM1User, 'Email Is Valid', 'String') @= 'Yes');
                sRecipient = CellGetS( 'System - Parameters - User', sTM1User, 'Email', 'String' );
            else;
                sAdmin1Email = CellGetS( 'System - Parameters', 'Administrator 1 Email', 'String' );
                sAdmin2Email = CellGetS( 'System - Parameters', 'Administrator 2 Email', 'String' );
                sAdmin3Email = CellGetS( 'System - Parameters', 'Administrator 3 Email', 'String' );  
            endif;
        endif;

        sCC = 'X';
        sBCC = 'X';

        if (nError = 0);
            sSubject = 'Workflow - Monthend setup';
        else;
            sSubject = '';
        endif;

        if 	(lower(sTM1User) @= 'admin');	sUsernameToDisplay = 'Admin';
        elseif 	(iCalledByChore = 1);		sUsernameToDisplay = 'a Chore [' | subst(sTM1User, 3, long(sTM1User) - 2) | ']';
        else;
            sUsernameToDisplay = trim(CellGetS('System - Parameters - User', Tm1User(), 'Full Name', 'String' ));
            if ( sUsernameToDisplay @= '' ); sUsernameToDisplay = sTM1User;  endif;
        endif;

        sEmailMessage = '';
        sEmailMessage = sEmailMessage | 'You have just clicked  a button to <b><font color="green">'|pType| '</b></font> . This was run at ' | TIMST(NOW(), '\h:\i:\s') | ' by ' | sUsernameToDisplay | '.<br>';
        sEmailMessage = sEmailMessage | '<p>The submission was made for '|pPeriod|' and '|pCompany|' for <b>'|pWorkflowItem|'</b></p><br><br>';
        sEmailMessage = sEmailMessage | '';

        sLogFilenameWithoutExtension = GetProcessName | ' EmailerLog';
        sAttachment = 'X';

        # Now call the process that sends the email.
        if (iCalledByChore = 1);
            if (sAdmin1Email @<> ''); 
                vResult = ExecuteProcess(sEmailProcess, 'pRecipient', sAdmin1Email, 'pCC', sCC, 'pBCC', sBCC, 'pSubject', sSubject, 
                                         'pBody', sEmailMessage, 'pLogFilenameWithoutExtension', sLogFilenameWithoutExtension, 'pAttachment', sAttachment);
            endif;
            if (sAdmin2Email @<> ''); 
                vResult = ExecuteProcess(sEmailProcess, 'pRecipient', sAdmin2Email, 'pCC', sCC, 'pBCC', sBCC, 'pSubject', sSubject, 
                                         'pBody', sEmailMessage, 'pLogFilenameWithoutExtension', sLogFilenameWithoutExtension, 'pAttachment', sAttachment); 
            endif;
            if (sAdmin3Email @<> ''); 
                vResult = ExecuteProcess(sEmailProcess, 'pRecipient', sAdmin3Email, 'pCC', sCC, 'pBCC', sBCC, 'pSubject', sSubject, 
                                         'pBody', sEmailMessage, 'pLogFilenameWithoutExtension', sLogFilenameWithoutExtension, 'pAttachment', sAttachment); 
            endif;
        Else;
            vResult = ExecuteProcess(sEmailProcess, 'pRecipient', sRecipient, 'pCC', sCC, 'pBCC', sBCC, 'pSubject', sSubject, 
                                     'pBody', sEmailMessage, 'pLogFilenameWithoutExtension', sLogFilenameWithoutExtension, 'pAttachment', sAttachment);
        endif;
    endif;
endif;


if (nError > 0); 
    ItemReject(sStatus); 
endif;
#endregion