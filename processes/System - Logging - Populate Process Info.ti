#region Prolog

####### SET PROCESSES DOCUMENTATION #####
#### Edit variables below
if (1=0); 
    sDescription = 'The process is a default process to be used as the base for all other processes developed'; 
    sDeveloper = 'Sempre: Shane James';    
    sSource = 'Source'; 
    sSourceType = 'Source Type'; 
    sTarget = 'Target'; 
    sTargetType = 'Target Type'; 

    sCube = 'System - Documentation - Model';
    If(DIMIX('Documentation' , 'Process: '|GetProcessname() ) = 0);
        ExecuteProcess('System - Documentation - Update or Create Documentation Dimensions', 'pIncludeControlObjects', 'N', 'pDocumentElements', 'N' );
    endif;
    If(CubeExists( sCube ) > 0);
        CellPutS( sDescription, sCube, 'Process: '|GetProcessname(), 'Description' );
        CellPutS( sSource, sCube, 'Process: '|GetProcessname(), 'Process Source' );
        CellPutS( sTarget, sCube, 'Process: '|GetProcessname(), 'Process Target' );
        CellPutS( sSourceType, sCube, 'Process: '|GetProcessname(), 'Process Source Type' );
        CellPutS( sTargetType, sCube, 'Process: '|GetProcessname(), 'Process Target Type' );
        CellPutS( sDeveloper, sCube, 'Process: '|GetProcessname(), 'Developer' );
    Endif;
endif;

#########################################

if (pConfirm @= 'N');
    sStatus = 'Process execution not confirmed';
    nError=1;
    ProcessBreak; 
endif;

sStartTime = TIMST( pStartTime , '\Y-\m-\d \h:\i:\s');
if (pEndTime = 0); 
    sEndTime = 'Current';
    sCompletionTime = 'Running';
else;
    sEndTime = TIMST( pEndTime , '\Y-\m-\d \h:\i:\s');
    sCompletionTime = TIMST(pEndTime - pStartTime, '\i m \s s');
endif;

##### Insert Time Record #############################
sDim = 'Time Processes';
if (DIMIX( sDim, sEndTime )=0); 
    DimensionElementInsertDirect(sDim, '', sEndTime, 'N' );  
endif;

#endregion
#region Epilog

### Populate Process info cube
##########################################################
sCube = 'System - Process Information';

CellPutN( pRecordsProcessed, sCube, sEndTime, pProcess, 'Records Processed' );
CellPutS( sStartTime, sCube, sEndTime, pProcess, 'Start Time' );
CellPutS( sEndTime, sCube, sEndTime, pProcess, 'End Time' );
CellPutS( pExecutedBy, sCube, sEndTime, pProcess, 'Executed By' );
CellPutS( pExecutionStatus, sCube, sEndTime, pProcess, 'Execution Status' );
CellPutS( 'Process', sCube, sEndTime, pProcess, 'Updated From' );
CellPutS( sCompletionTime, sCube, sEndTime, pProcess, 'Completion Time' );
CellPutS( pServerLogFile, sCube, sEndTime, pProcess, 'Server Log File' );
CellPutS( pParametersUsed, sCube, sEndTime, pProcess, 'Parameters Used' );
CellPutS( pProcessMessage, sCube, sEndTime, pProcess, 'Process Message' );


if (pProcessStage @= 'Epilog'); 
    sEndTime = 'Current';
    CellPutN( pRecordsProcessed, sCube, sEndTime, pProcess, 'Records Processed' );
    CellPutS( sStartTime, sCube, sEndTime, pProcess, 'Start Time' );
    CellPutS( sEndTime, sCube, sEndTime, pProcess, 'End Time' );
    CellPutS( pExecutedBy, sCube, sEndTime, pProcess, 'Executed By' );
    CellPutS( pExecutionStatus, sCube, sEndTime, pProcess, 'Execution Status' );
    CellPutS( 'Process', sCube, sEndTime, pProcess, 'Updated From' );
    CellPutS( sCompletionTime, sCube, sEndTime, pProcess, 'Completion Time' );
    CellPutS( pServerLogFile, sCube, sEndTime, pProcess, 'Server Log File' );
    CellPutS( pParametersUsed, sCube, sEndTime, pProcess, 'Parameters Used' );
    CellPutS( pProcessMessage, sCube, sEndTime, pProcess, 'Process Message' );
endif;


#### Add latest to documention cube
if (pProcessStage @= 'Epilog'); 
    sCube = 'System - Documentation - Model';
    CellPutS( sCompletionTime, sCube, 'Process: '|pProcess, 'Process Last Run Time' );
    CellPutS( sEndTime, sCube, 'Process: '|pProcess, 'Process Last Run' );
endif;

########################################



#endregion